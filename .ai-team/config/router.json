{
  "version": "5.4-lite",
  "router": {
    "mode": "recommendation_only",
    "external_execution": false,
    "reasoning_selection": "adaptive_lowest_sufficient",
    "allowed_tools": [
      "router_status",
      "route_task",
      "goal_bootstrap",
      "goal_get_state",
      "goal_checkpoint",
      "goal_resume",
      "goal_finalize"
    ]
  },
  "reasoning_policy": {
    "strategy": "adaptive_lowest_sufficient",
    "default_difficulty": "auto",
    "difficulty_levels": ["trivial", "routine", "complex", "critical"],
    "models": {
      "gpt-5.6-sol": {"minimum": "low", "maximum": "xhigh", "default": "high"},
      "gpt-5.6-terra": {"minimum": "low", "maximum": "xhigh", "default": "medium"},
      "gpt-5.6-luna": {"minimum": "high", "maximum": "max", "default": "high"}
    }
  },
  "agents": {
    "planner": {"model": "gpt-5.6-sol", "reasoning_effort": "high", "reasoning_minimum": "low", "reasoning_maximum": "xhigh", "reasoning_selection": "adaptive_lowest_sufficient", "sandbox_mode": "read-only"},
    "explorer": {"model": "gemini-3.6-flash-high", "reasoning_effort": "high", "sandbox_mode": "gemini-wrapper-read-only", "wrapper": ".ai-team/scripts/Invoke-AgyFast.ps1"},
    "analyst": {"model": "gemini-3.1-pro-high", "reasoning_effort": "high", "sandbox_mode": "gemini-wrapper-read-only", "wrapper": ".ai-team/scripts/Invoke-AgyDeep.ps1"},
    "worker": {"model": "gpt-5.6-terra", "reasoning_effort": "medium", "reasoning_minimum": "low", "reasoning_maximum": "xhigh", "reasoning_selection": "adaptive_lowest_sufficient", "sandbox_mode": "workspace-write"},
    "worker-deep": {"model": "gpt-5.6-terra", "reasoning_effort": "high", "reasoning_minimum": "low", "reasoning_maximum": "xhigh", "reasoning_selection": "adaptive_lowest_sufficient", "sandbox_mode": "workspace-write"},
    "reviewer": {"model": "gemini-3.1-pro-high", "reasoning_effort": "high", "sandbox_mode": "gemini-wrapper-read-only", "wrapper": ".ai-team/scripts/Invoke-AgyDeep.ps1"}
  },
  "gemini_profiles": {
    "fast": {"model": "gemini-3.6-flash-high", "reasoning_effort": "high", "wrapper": ".ai-team/scripts/Invoke-AgyFast.ps1"},
    "deep": {"model": "gemini-3.1-pro-high", "reasoning_effort": "high", "wrapper": ".ai-team/scripts/Invoke-AgyDeep.ps1"}
  },
  "codex_profiles": {
    "luna": {
      "model": "gpt-5.6-luna",
      "reasoning_effort": "high",
      "reasoning_minimum": "high",
      "reasoning_maximum": "max",
      "reasoning_selection": "adaptive_lowest_sufficient",
      "sandbox_mode": "read-only",
      "provider": "native_agent",
      "fallback_only": true,
      "availability": "runtime_dependent",
      "invocation": "native_agent_handoff_only"
    }
  },
  "fallback_chains": {
    "gemini_fast": {
      "max_total_attempts": 2,
      "profiles": [
        {"profile": "gemini_fast", "max_attempts": 1},
        {"profile": "gemini_deep", "max_attempts": 1},
        {"profile": "codex_luna", "max_attempts": 0}
      ]
    },
    "gemini_deep": {
      "max_total_attempts": 2,
      "profiles": [
        {"profile": "gemini_deep", "max_attempts": 1},
        {"profile": "gemini_fast", "max_attempts": 1},
        {"profile": "codex_luna", "max_attempts": 0}
      ]
    }
  }
}
