{
  "version": "5.4-style",
  "active_mode": "style",
  "active_mode_id": "ai-team-style",
  "active_mode_name": "風格模式",
  "active_mode_display": "風格模式 (ai-team-style)",
  "router": {
    "mode": "recommendation_only",
    "external_execution": false,
    "reasoning_selection": "adaptive_lowest_sufficient",
    "allowed_tools": [
      "router_status",
      "route_task",
      "goal_bootstrap",
      "goal_get_state",
      "goal_checkpoint",
      "goal_resume",
      "goal_finalize"
    ]
  },
  "git_policy": {
    "auto_push": {
      "enabled": true,
      "allowed_branch_pattern": "codex/*",
      "force_push": false,
      "direct_default_branch_push": false
    },
    "auto_merge": {
      "enabled": true,
      "mechanism": "protected_pr_only",
      "require_branch_protection": true,
      "require_green_ci": true,
      "required_checks": [
        "Lint",
        "Typecheck",
        "AI Team router and resilience tests",
        "Unit tests and coverage thresholds"
      ],
      "allow_merge_conflicts": false
    },
    "production_deploy": {
      "enabled": false,
      "approval": "manual",
      "workflow_dispatch_only": true,
      "auto_trigger_from_merge": false
    }
  },
  "reasoning_policy": {
    "strategy": "adaptive_lowest_sufficient",
    "default_difficulty": "routine",
    "difficulty_levels": ["trivial", "routine", "complex", "critical"],
    "models": {
      "gpt-5.6-luna": {"minimum": "low", "maximum": "medium", "default": "low"},
      "gpt-5.6-terra": {"minimum": "low", "maximum": "medium", "default": "medium"},
      "gemini-3.8-flash-high": {"minimum": "low", "maximum": "high", "default": "high"}
    }
  },
  "agents": {
    "planner": {
      "model": "gemini-3.8-flash-high",
      "reasoning_effort": "high",
      "sandbox_mode": "read-only",
      "wrapper": ".ai-team/scripts/Invoke-AgyFast.ps1",
      "role": "visual_and_layout_planner",
      "description": "Zero-quota layout and visual structure planner, extracting component patterns and bento grid architectures"
    },
    "explorer": {
      "model": "gemini-3.8-flash-high",
      "reasoning_effort": "high",
      "sandbox_mode": "gemini-wrapper-read-only",
      "wrapper": ".ai-team/scripts/Invoke-AgyFast.ps1"
    },
    "analyst": {
      "model": "gemini-3.8-flash-high",
      "reasoning_effort": "high",
      "sandbox_mode": "gemini-wrapper-read-only",
      "wrapper": ".ai-team/scripts/Invoke-AgyFast.ps1"
    },
    "worker": {
      "profile": "luna_worker_style",
      "model": "gpt-5.6-luna",
      "reasoning_effort": "low",
      "reasoning_minimum": "low",
      "reasoning_maximum": "medium",
      "reasoning_selection": "adaptive_lowest_sufficient",
      "sandbox_mode": "workspace-write",
      "provider": "native_agent",
      "availability": "runtime_dependent",
      "fallback_only": false,
      "description": "Low-reasoning UI/UX implementer specializing in Tailwind, JSX assembly, and commercial component filling"
    },
    "worker-deep": {
      "model": "gpt-5.6-terra",
      "reasoning_effort": "medium",
      "reasoning_minimum": "low",
      "reasoning_maximum": "medium",
      "reasoning_selection": "adaptive_lowest_sufficient",
      "sandbox_mode": "workspace-write"
    },
    "reviewer": {
      "model": "gpt-5.6-terra",
      "reasoning_effort": "low",
      "reasoning_minimum": "low",
      "reasoning_maximum": "medium",
      "reasoning_selection": "adaptive_lowest_sufficient",
      "sandbox_mode": "read-only",
      "provider": "native_agent",
      "availability": "runtime_dependent"
    }
  },
  "gemini_profiles": {
    "fast": {"model": "gemini-3.8-flash-high", "reasoning_effort": "high", "wrapper": ".ai-team/scripts/Invoke-AgyFast.ps1"},
    "deep": {"model": "gemini-3.8-flash-high", "reasoning_effort": "high", "wrapper": ".ai-team/scripts/Invoke-AgyFast.ps1"}
  },
  "plan_review": {
    "enabled": true,
    "required": false,
    "skip_routine_tasks": true,
    "trigger_difficulties": ["critical"],
    "trigger_risk_domains": ["security", "payment"],
    "profile": "claude_plan_review",
    "model": "claude-sonnet-4-6",
    "reasoning_effort": "model-default",
    "wrapper": ".ai-team/scripts/Invoke-AgyPlanReview.ps1",
    "sandbox_mode": "agy-wrapper-read-only",
    "availability": "runtime_dependent",
    "execution": "advisory_only",
    "quota_policy": "skip_if_unavailable",
    "fallback_chain": [
      {
        "tier": 1,
        "profile": "claude_plan_review",
        "model": "claude-sonnet-4-6",
        "role": "aesthetic_visual_audit",
        "description": "Advisory visual aesthetic reviewer only triggered for critical milestone acceptance"
      },
      {
        "tier": 2,
        "profile": "gemini_flash_review",
        "model": "gemini-3.8-flash-high",
        "wrapper": ".ai-team/scripts/Invoke-AgyFast.ps1",
        "role": "fast_sanity_check",
        "description": "Zero-quota fast layout and accessibility sanity check"
      },
      {
        "tier": 3,
        "action": "skip_review",
        "description": "Routine UI and styling bypasses AI review completely, relying on local deterministic typecheck and tests"
      }
    ],
    "max_attempts": 1
  },
  "codex_profiles": {
    "luna_worker_style": {
      "model": "gpt-5.6-luna",
      "reasoning_effort": "low",
      "reasoning_minimum": "low",
      "reasoning_maximum": "medium",
      "reasoning_selection": "adaptive_lowest_sufficient",
      "sandbox_mode": "workspace-write",
      "provider": "native_agent",
      "fallback_only": false,
      "availability": "runtime_dependent",
      "invocation": "native_agent_handoff_only"
    }
  }
}
