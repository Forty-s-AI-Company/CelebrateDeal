{
  "schemaVersion": "celebratedeal-ai-team-wp122-onboarding-contract/v1",
  "workPackage": "WP-122",
  "contractStatus": "DRAFT_LOCAL_ONLY",
  "environment": "local",
  "evidencePolicy": [
    "LOCAL_EVIDENCE",
    "EXTERNAL_REQUIRED",
    "MANUAL_REQUIRED",
    "OWNER_ACCEPTANCE_REQUIRED",
    "BLOCKED"
  ],
  "roles": [
    { "id": "merchant_owner", "responsibility": "商家責任與風險接受", "cannotReplace": ["legal_approval", "release_owner"] },
    { "id": "merchant_admin", "responsibility": "品牌、商品、直播與日常設定", "cannotReplace": ["merchant_owner"] },
    { "id": "merchant_accountant", "responsibility": "帳務投影與付款退款核對", "cannotReplace": ["provider_operation", "release_owner"] },
    { "id": "support_operator", "responsibility": "事件受理、停止與升級", "cannotReplace": ["provider_operation"] },
    { "id": "platform_admin", "responsibility": "平台設定、權限與帳務投影判讀", "cannotReplace": ["merchant_owner", "release_owner"] },
    { "id": "release_owner", "responsibility": "正式環境範圍、風險與回滾決定", "cannotReplace": ["legal_approval", "merchant_owner"] }
  ],
  "stages": [
    {
      "id": "merchant_owner_identity",
      "purpose": "確認唯一主要責任歸屬與替代聯絡流程",
      "ownerRoles": ["merchant_owner"],
      "entryCriteria": ["商家提供去識別責任範圍"],
      "exitCriteria": ["owner acceptance evidence 已標示範圍與結論"],
      "requiredEvidence": [{ "type": "owner_scope", "status": "OWNER_ACCEPTANCE_REQUIRED" }],
      "blocking": true,
      "rollback": "停止 onboarding 並保留 BLOCKED handoff",
      "escalation": "交給 release_owner 判斷是否需要補件",
      "dataSensitivity": "synthetic_reference_only",
      "automationStatus": "MANUAL_REQUIRED",
      "handoff": "merchant_owner_to_platform_admin_and_release_owner"
    },
    {
      "id": "security_mfa_minimum_privilege",
      "purpose": "確認密碼、session、MFA、recovery 與最小權限邊界",
      "ownerRoles": ["merchant_owner", "platform_admin"],
      "entryCriteria": ["受控帳號與安全設定入口可用"],
      "exitCriteria": ["local tests 與真人受控設定證據分開保存"],
      "requiredEvidence": [{ "type": "security_boundary", "status": "LOCAL_EVIDENCE" }, { "type": "controlled_setup", "status": "MANUAL_REQUIRED" }],
      "blocking": true,
      "rollback": "撤銷未完成設定並回到 BLOCKED",
      "escalation": "platform_admin_to_release_owner",
      "dataSensitivity": "credential_free",
      "automationStatus": "LOCAL_PLUS_MANUAL",
      "handoff": "platform_admin_to_merchant_owner"
    },
    {
      "id": "members_roles_active_owner",
      "purpose": "確認成員邀請、角色邊界與至少一位 active owner",
      "ownerRoles": ["merchant_owner", "platform_admin"],
      "entryCriteria": ["階段二已完成且角色需求已寫明"],
      "exitCriteria": ["角色清單與 active owner 證據可去識別交接"],
      "requiredEvidence": [{ "type": "role_boundary", "status": "LOCAL_EVIDENCE" }, { "type": "active_owner_login", "status": "MANUAL_REQUIRED" }],
      "blocking": true,
      "rollback": "停止邀請與權限變更，標示 active owner 缺口",
      "escalation": "platform_admin_to_merchant_owner",
      "dataSensitivity": "synthetic_reference_only",
      "automationStatus": "LOCAL_PLUS_MANUAL",
      "handoff": "merchant_owner_to_platform_admin"
    },
    {
      "id": "branding_tracking",
      "purpose": "確認品牌與 tracking 責任及同意邊界",
      "ownerRoles": ["merchant_admin"],
      "entryCriteria": ["merchant_owner 已指定設定責任"],
      "exitCriteria": ["去識別設定摘要與未決決策已交接"],
      "requiredEvidence": [{ "type": "settings_entry", "status": "LOCAL_EVIDENCE" }, { "type": "consent_review", "status": "MANUAL_REQUIRED" }],
      "blocking": true,
      "rollback": "取消未確認的 tracking 設定",
      "escalation": "merchant_admin_to_merchant_owner",
      "dataSensitivity": "synthetic_reference_only",
      "automationStatus": "LOCAL_PLUS_MANUAL",
      "handoff": "merchant_admin_to_merchant_owner"
    },
    {
      "id": "product_live_forms_interactions",
      "purpose": "以 synthetic 內容演練商品、直播、表單與互動角色",
      "ownerRoles": ["merchant_admin"],
      "entryCriteria": ["階段三角色確認完成"],
      "exitCriteria": ["synthetic journey 可辨識且權限邊界有證據"],
      "requiredEvidence": [{ "type": "dashboard_checklist", "status": "LOCAL_EVIDENCE" }, { "type": "synthetic_journey", "status": "MANUAL_REQUIRED" }],
      "blocking": true,
      "rollback": "移除未驗證的 synthetic draft，不觸碰正式內容",
      "escalation": "merchant_admin_to_platform_admin",
      "dataSensitivity": "synthetic_content_only",
      "automationStatus": "LOCAL_PLUS_MANUAL",
      "handoff": "merchant_admin_to_merchant_owner"
    },
    {
      "id": "plans_payuni_boundary",
      "purpose": "分開本機付款邊界、Sandbox evidence 與正式 merchant 決策",
      "ownerRoles": ["merchant_accountant", "platform_admin"],
      "entryCriteria": ["訂價與退款責任人已指定"],
      "exitCriteria": ["Sandbox、staging、production evidence 分類與禁止事項已交接"],
      "requiredEvidence": [{ "type": "sandbox_receipt", "status": "EXTERNAL_REQUIRED" }, { "type": "local_boundary", "status": "LOCAL_EVIDENCE" }],
      "blocking": true,
      "rollback": "停止付款／退款操作，不重送 provider request",
      "escalation": "platform_admin_to_release_owner",
      "dataSensitivity": "synthetic_payment_reference_only",
      "automationStatus": "LOCAL_PLUS_EXTERNAL",
      "handoff": "merchant_accountant_to_release_owner"
    },
    {
      "id": "support_refund_sop",
      "purpose": "交接支援、退款 SOP、P0/P1/P2 與升級路徑",
      "ownerRoles": ["support_operator", "merchant_accountant"],
      "entryCriteria": ["付款退款與事件 SOP 已可讀"],
      "exitCriteria": ["支援與財務 owner 對流程的接受結論已記錄"],
      "requiredEvidence": [{ "type": "support_sop", "status": "LOCAL_EVIDENCE" }, { "type": "support_owner_acceptance", "status": "OWNER_ACCEPTANCE_REQUIRED" }],
      "blocking": true,
      "rollback": "停止事件交接並回到已知安全升級入口",
      "escalation": "support_operator_to_release_owner",
      "dataSensitivity": "deidentified_handoff_only",
      "automationStatus": "LOCAL_PLUS_OWNER",
      "handoff": "support_operator_to_release_owner"
    },
    {
      "id": "dns_terms_policy_release_acceptance",
      "purpose": "確認 DNS、條款、隱私、退款政策與正式 owner acceptance",
      "ownerRoles": ["release_owner", "merchant_owner"],
      "entryCriteria": ["前七階段具去識別 evidence 且 production scope 明確"],
      "exitCriteria": ["外部環境、法務政策與正式 rollback acceptance 全部有 receipt"],
      "requiredEvidence": [{ "type": "dns_environment", "status": "EXTERNAL_REQUIRED" }, { "type": "legal_policy", "status": "MANUAL_REQUIRED" }, { "type": "release_acceptance", "status": "OWNER_ACCEPTANCE_REQUIRED" }],
      "blocking": true,
      "rollback": "維持未上線狀態並執行 release rollback plan",
      "escalation": "release_owner_to_merchant_owner",
      "dataSensitivity": "deidentified_scope_only",
      "automationStatus": "EXTERNAL_PLUS_MANUAL",
      "handoff": "release_owner_to_launch_governance"
    }
  ]
}
