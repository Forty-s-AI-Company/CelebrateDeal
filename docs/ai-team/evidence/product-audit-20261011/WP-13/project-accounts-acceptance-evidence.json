    {
      "severity": "MAJOR",
      "area": "Old-message suppression / message deduplication",
      "file": "src/lib/line-notification.ts",
      "issue": "Delivery deduplication keys are unique per vendor and leave out the LINE account, so a message re-queued after a Project switch is matched to the old account's suppressed row and never created for the new account.",
      "impact": "After a switch, registration_confirmed, live_reminder and live_started messages already queued through the old account are suppressed and can never be sent through the new account.",
      "evidence": "LineDelivery has @@unique([vendorId, idempotencyKey]), enqueue returns 'duplicate' when that key conflicts, and checkWebinarDeliverySource rebuilds the expected key without any account ID.",
      "recommended_fix": "Add lineOfficialAccountId to the deduplication scope, either in the key itself or as @@unique([vendorId, lineOfficialAccountId, idempotencyKey]), and include it in the expected-key check.",
      "required_test": "Queue live_reminder on account A, switch the Project to B, re-link and re-queue, then assert that A's row is suppressed and B's row is queued and sent.",
      "confidence": 0.75,
      "review": "core",
      "id": "core-1",
      "disposition": "resolved",
