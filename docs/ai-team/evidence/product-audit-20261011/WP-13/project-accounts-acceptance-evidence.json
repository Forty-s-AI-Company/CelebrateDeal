    {
      "severity": "MAJOR",
      "area": "OAuth / login",
      "file": "src/lib/line-login.ts",
      "issue": "completeLineLogin accepts any valid state/code pair without checking that the callback comes from the browser that started the flow.",
      "impact": "An attacker can send a victim a callback URL from the attacker's own flow, which links the attacker's LINE account to the victim's subject (or the reverse) or signs the victim in as the attacker.",
      "evidence": "beginLineLogin returns only the authorization URL, and completeLineLogin({state, code}) checks only the stored stateHash, with no cookie or session-bound value.",
      "recommended_fix": "In beginLineLogin, set an HttpOnly, SameSite=Lax cookie tied to the state hash, and require it in completeLineLogin; for 'user' subjects, also check the current session user.",
      "required_test": "Finishing the callback in a different browser, without the cookie set at the start, must be rejected and leave the state unconsumed.",
      "confidence": 0.5,
      "review": "core",
      "id": "core-2",
