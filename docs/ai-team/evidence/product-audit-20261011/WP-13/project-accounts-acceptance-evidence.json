      "severity": "MINOR",
      "area": "Migration / schema drift",
      "file": "prisma/migrations/20261016190000_project_line_accounts/migration.sql",
      "issue": "The migration's conditional unique indexes (LineOfficialAccount_one_default_per_vendor and LineRichMenuDraft_unbound_per_vendor) are not described in schema.prisma.",
      "impact": "A later 'prisma migrate dev' may report drift and generate a DROP INDEX, which would silently remove the one-default-per-vendor rule that login and webhook routing depend on.",
      "evidence": "schema.prisma only declares @@unique([vendorId, id]) on LineOfficialAccount, while the SQL creates a unique index on (vendorId) WHERE isDefault.",
      "recommended_fix": "Describe the conditional indexes in the schema where Prisma supports it, or document them and add a CI check that the next generated migration does not drop them.",
      "required_test": "Run prisma migrate diff against the migrated database in CI and assert that no DROP INDEX statements are produced.",
      "confidence": 0.5,
      "review": "core",
      "id": "core-4",
      "disposition": "unresolved"
    },
    {
      "severity": "NIT",
      "area": "Legacy backfill / identity uniqueness",
      "file": "prisma/migrations/20261016190000_project_line_accounts/migration.sql",
      "issue": "LineUserIdentity.lineOfficialAccountId stays nullable after the backfill, and Postgres treats NULLs as distinct in the new unique index.",
      "impact": "Identities from vendors with no account remain NULL; they can duplicate subjects and can never be routed or revoked through any account.",
      "evidence": "The backfill only joins vendors that have an account; there is no NOT NULL constraint or cleanup step for the remaining rows.",
