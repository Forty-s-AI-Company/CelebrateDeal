{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "noUncheckedIndexedAccess": true
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/generated/**"
  ]
}
