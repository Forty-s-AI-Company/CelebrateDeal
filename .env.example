# Local development can use a local Postgres container.
# For Supabase production:
# - DATABASE_URL should be the runtime connection string used by the app.
# - DIRECT_URL should be the direct database connection used by Prisma migrations.
DATABASE_URL="postgresql://postgres:postgres@localhost:54329/celebratedeal_dev?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:54329/celebratedeal_dev?schema=public"

NEXT_PUBLIC_APP_URL="http://localhost:31023"
NODE_ENV="development"
# 本機用的佔位值；也是 MFA、邀請連結等衍生金鑰的來源，至少 32 bytes。部署環境請換成獨立的隨機值。
CSRF_SECRET="dev-csrf-secret-for-local-only-32bytes!"
RATE_LIMIT_PROVIDER="memory"
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Cloudflare Stream / Stream Live
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_STREAM_TOKEN=""
CLOUDFLARE_STREAM_WEBHOOK_SECRET=""

# Landing pages
# 平台級緊急開關：設為 "1" 或 "true" 時，暫停所有商家「不需發布專案就公開」的名單型網站
# 新發布（已公開的網站不受影響、可重新發布）。未設定或其他值＝開啟（預設）。
INDEPENDENT_AUDIENCE_PUBLISH_DISABLED=""

# Merchant registration
# 商家註冊模式：invite＝僅限平台管理員在 /admin/merchant-invitations 產生的邀請連結（封測預設）；
# open＝任何人都能在 /register 註冊。未設定、空字串或其他值一律視為 invite。
# 商家 Email 驗證已內建（註冊後自動寄驗證信）；Preview／Production 改成 open 前必須設定下方 Turnstile 兩個金鑰與寄信設定，
# 否則 preflight 失敗。
# 本機開發若想直接用 /register 建立測試商家，可以設成 REGISTRATION_MODE="open"。
REGISTRATION_MODE="invite"

# Cloudflare Turnstile（註冊頁與重新寄送驗證信的真人驗證）。兩個都留空＝停用（表單照常可用，
# preflight 會提醒）；只設一個會讓 preflight 失敗。Preview／Production 設 REGISTRATION_MODE=open 時
# 兩個都必須設定，否則 preflight 失敗。請填 owner 在 Cloudflare 建立的 widget 金鑰，不要提交真實值；
# 本機測試可用 Cloudflare 文件公開的測試金鑰（例如永遠通過的 1x00000000000000000000AA／
# 1x0000000000000000000000000000000AA）。
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
# Cloudflare 的測試金鑰在 Vercel Preview／Production 一律拒絕（preflight 失敗）。伺服器會核對 siteverify 回傳的
# hostname：預設接受 NEXT_PUBLIC_APP_URL 的主機與該次 Vercel preview 自己的網址；其他要接受的主機用逗號列在這裡。
TURNSTILE_ALLOWED_HOSTNAMES=""

# Payment provider
# PayUni ReturnURL / NotifyURL are generated from NEXT_PUBLIC_APP_URL and must
# use a public, non-Production Staging host. Never put a Vercel automation
# bypass secret in either URL: PayUni stores NotifyURL and shows ReturnURL to
# the payer.
# Callback authenticity uses the official EncryptInfo + HashInfo contract.
PAYMENT_PROVIDER="demo"
PAYUNI_ENV="sandbox"
PAYUNI_SANDBOX_QA_ENABLED="false"
PAYUNI_SANDBOX_REFUND_ENABLED="false"
# 必須是經 Vercel inspect 確認非 Production target 的公開 Staging host。
PAYUNI_TEST_APP_URL=""
PAYUNI_STAGING_ALLOWED_HOST=""
PAYUNI_PRODUCTION_APP_HOST="celebratedeal.carry-digital-nomad.in.net"
PAYUNI_TEST_LIVE_PATH="/live/summer-glow-live"
PAYUNI_SANDBOX_ONETIME_CARD_NO=""
PAYUNI_TEST_EXPIRY=""
PAYUNI_TEST_CVV=""
PAYUNI_HASH_KEY=""
PAYUNI_HASH_IV=""
PAYUNI_MERCHANT_ID=""
ECPAY_WEBHOOK_SECRET=""
PAYMENT_WEBHOOK_MAX_RETRIES="5"

# Email / monitoring / analytics
RESEND_API_KEY=""
EMAIL_FROM="CelebrateDeal <no-reply@dev.celebratedeal.local>"
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"

# Jobs
JOB_SECRET="dev-job-secret-123456"

# External smoke tests
TARGET_APP_URL="http://localhost:31023"
SMOKE_TEST_EMAIL=""
SMOKE_VENDOR_ID=""
SMOKE_VENDOR_SLUG=""
RUN_CLOUDFLARE_SMOKE="false"
RUN_DEMO_PAYMENT_WEBHOOK_SMOKE="false"

# One-time platform admin bootstrap
# Used only by `npm run admin:bootstrap`; do not expose these in client code.
PLATFORM_ADMIN_EMAIL="admin@example.com"
PLATFORM_ADMIN_PASSWORD="change-me-with-at-least-12-characters"
PLATFORM_ADMIN_NAME="Platform Admin"
PLATFORM_ADMIN_RESET_PASSWORD="false"
