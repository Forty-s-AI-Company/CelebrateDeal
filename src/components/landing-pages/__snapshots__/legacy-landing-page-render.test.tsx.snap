exports[`legacy public renderer (published legacy versions keep rendering until republished) > renders the webinar template exactly as before 1`] = `"<main class="mx-auto min-h-screen w-full max-w-6xl space-y-12 bg-white px-4 py-8 text-slate-950 sm:px-6 md:space-y-16 "><section class=" relative isolate mx-auto overflow-hidden rounded-3xl bg-gradient-to-br from-blue-950 via-blue-900 to-blue-700 px-7 py-16 text-white shadow-lg md:px-12"><div class="max-w-3xl"><p class="text-sm font-black tracking-[0.2em] text-blue-200">免費線上講座</p><h1 class="mt-3 text-4xl font-black tracking-tight sm:text-6xl">用一場直播，讓對的人認識你的價值</h1><p class="mt-5 whitespace-pre-line text-lg leading-8 text-blue-100">保留你的席次，活動開始前我們會提醒你。</p><div class="mt-8"><a class="inline-flex w-fit items-center justify-center rounded-xl px-5 py-3 font-bold shadow-sm transition focus-visible:outline-2 focus-visible:outline-offset-4 bg-white text-blue-900 hover:bg-blue-50" href="/form/webinar-signup?liveId=live_1&amp;lp=page_1">立即保留席次</a></div></div></section><section class=" mx-auto"><h2 class="text-3xl font-black">你會帶走什麼</h2><div class="mt-5 grid gap-4 md:grid-cols-2"><article class="rounded-2xl border border-slate-200 p-5"><h3 class="font-bold">清楚的行動方向</h3><p class="mt-2 text-slate-600">把複雜的下一步拆成今天就能開始的小事。</p></article><article class="rounded-2xl border border-slate-200 p-5"><h3 class="font-bold">可複製的方法</h3><p class="mt-2 text-slate-600">用適合自己的節奏，穩穩做出成果。</p></article></div></section><section class=" mx-auto flex gap-5"><div><h2 class="text-2xl font-black">講者姓名</h2><p class="mt-1 font-medium text-slate-600">講者職稱（請填寫）</p><p class="mt-3 whitespace-pre-line leading-7 text-slate-700">在這裡補上講者的專業背景與本次分享重點。</p></div></section><section class=" mx-auto"><h2 class="text-3xl font-black">活動流程</h2><div class="mt-4 border-l-2 border-blue-500 pl-4"><p class="text-sm font-bold text-blue-700">00:00</p><h3 class="font-bold">開場與主題介紹</h3><p class="text-slate-600">認識今天的分享內容與學習目標。</p></div><div class="mt-4 border-l-2 border-blue-500 pl-4"><p class="text-sm font-bold text-blue-700">00:15</p><h3 class="font-bold">主題分享</h3><p class="text-slate-600">請填寫本場講座的重點段落。</p></div><div class="mt-4 border-l-2 border-blue-500 pl-4"><p class="text-sm font-bold text-blue-700">00:50</p><h3 class="font-bold">問答與交流</h3><p class="text-slate-600">留下你的問題，和講者一起找到下一步。</p></div></section><section class=" mx-auto"><h2 class="text-3xl font-black">常見問題</h2><details class="mt-3 rounded-xl border border-slate-200 p-4"><summary class="cursor-pointer font-bold">活動會提供回放嗎？</summary><p class="mt-3 whitespace-pre-line leading-7 text-slate-600">請依實際活動安排補上回放說明。</p></details><details class="mt-3 rounded-xl border border-slate-200 p-4"><summary class="cursor-pointer font-bold">報名後如何參加？</summary><p class="mt-3 whitespace-pre-line leading-7 text-slate-600">完成報名後，活動連結與提醒將依你的報名資料寄送。</p></details></section><section class=" mx-auto rounded-3xl bg-blue-600 p-8 text-center text-white shadow-lg"><h2 class="text-3xl font-black">準備好了嗎？</h2><p class="mt-3 whitespace-pre-line text-blue-100">現在報名，保留你的線上席次。</p><div class="mt-5"><a class="inline-flex w-fit items-center justify-center rounded-xl px-5 py-3 font-bold shadow-sm transition focus-visible:outline-2 focus-visible:outline-offset-4 bg-white text-blue-900 hover:bg-blue-50" href="/form/webinar-signup?liveId=live_1&amp;lp=page_1">立即報名</a></div></section></main>"`;
