  commerceOrderRefunds        CommerceOrderRefund[]
  supportRefundHandoffs       SupportRefundHandoff[]

  @@unique([vendorId, id])
  @@unique([vendorId, checkoutIdempotencyKey])
  @@index([vendorId, occurredAt])
  @@index([vendorId, orderNumber])
  @@index([status, occurredAt])
}

/// Canonical, tenant-owned sales order. Buyer and shipping plaintext never
/// belong in this model; only encrypted envelopes and safe display masks do.
model CommerceOrder {
  id                          String              @id @default(cuid())
  vendorId                    String
  orderNumber                 String
  checkoutIdempotencyKey      String
  checkoutIdentityHash        String
  primaryPaymentTransactionId String?
  status                      CommerceOrderStatus @default(pending_payment)
  currency                    String              @default("TWD")
  subtotalAmountCents         Int
  totalAmountCents            Int
  paidAmountCents             Int                 @default(0)
  refundedAmountCents         Int                 @default(0)
  buyerEncryptedEnvelope      String
  buyerMaskedName             String
  buyerMaskedEmail            String
  buyerMaskedPhone            String?
  shippingEncryptedEnvelope   String?
  shippingMaskedSummary       String?
  paidAt                      DateTime?
  failedAt                    DateTime?
  refundedAt                  DateTime?
  createdAt                   DateTime            @default(now())
  updatedAt                   DateTime            @updatedAt

  vendor                    Vendor                              @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  primaryPaymentTransaction PaymentTransaction?                 @relation("CommerceOrderPrimaryPayment", fields: [vendorId, primaryPaymentTransactionId], references: [vendorId, id], onDelete: Restrict)
  items                     CommerceOrderItem[]
  events                    CommerceOrderEvent[]
  refunds                   CommerceOrderRefund[]
  supportCases              SupportCase[]
  supportRefundHandoffs     SupportRefundHandoff[]
  buyerSupportOrderGrants   BuyerSupportOrderGrant[]
  deliverySnapshots         CommerceOrderItemDeliverySnapshot[]

  @@unique([vendorId, id])
  @@unique([vendorId, orderNumber])
  @@unique([vendorId, checkoutIdempotencyKey])
  @@unique([vendorId, primaryPaymentTransactionId])
  @@index([vendorId, status, createdAt])
  @@index([vendorId, paidAt])
}

/// Immutable commercial terms captured at purchase time. Product fields remain
/// snapshots so later catalogue edits cannot rewrite a completed order.
model CommerceOrderItem {
  id                                     String                  @id @default(cuid())
  vendorId                               String
  orderId                                String
  productId                              String?
  lineIndex                              Int
  productName                            String
  productSlug                            String
  commerceDomain                         String
  fulfillmentType                        CommerceFulfillmentType
  unitPriceCents                         Int
  quantity                               Int
  lineTotalCents                         Int
  imageUrl                               String?
  nonSensitiveSnapshot                   Json
  customCheckoutAnswersEncryptedEnvelope String?
  createdAt                              DateTime                @default(now())

  vendor              Vendor                             @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  order               CommerceOrder                      @relation(fields: [vendorId, orderId], references: [vendorId, id], onDelete: Cascade)
  product             Product?                           @relation(fields: [vendorId, productId], references: [vendorId, id], onDelete: Restrict)
  shippingFulfillment ShippingFulfillment?
  entitlement         CommerceEntitlement?
  serviceFulfillment  ServiceFulfillment?
  deliverySnapshot    CommerceOrderItemDeliverySnapshot?

  @@unique([vendorId, id])
  @@unique([vendorId, orderId, id])
  @@unique([vendorId, orderId, lineIndex])
  @@index([vendorId, productId])
  @@index([vendorId, fulfillmentType])
}

/// Append-only, sanitized order history. Do not add mutable business fields.
model CommerceOrderEvent {
  id            String   @id @default(cuid())
  vendorId      String
  orderId       String
  dedupKey      String
  eventType     String
  actorType     String
  actorId       String?
  sanitizedData Json?
  occurredAt    DateTime @default(now())
  createdAt     DateTime @default(now())

  vendor Vendor        @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  order  CommerceOrder @relation(fields: [vendorId, orderId], references: [vendorId, id], onDelete: Cascade)

  @@unique([vendorId, id])
  @@unique([vendorId, orderId, dedupKey])
  @@index([vendorId, orderId, occurredAt])
  @@index([vendorId, eventType, occurredAt])
}

/// Provider-event idempotent refund ledger. Cumulative amounts are persisted so
/// reconciliation can audit partial and full refunds without mutating history.
model CommerceOrderRefund {
  id                    String                    @id @default(cuid())
  vendorId              String
  orderId               String
  paymentTransactionId  String?
  refundRecordId        String?
  providerName          String
  eventIdentity         String
  amountCents           Int
  cumulativeAmountCents Int
  status                CommerceOrderRefundStatus @default(processed)
  occurredAt            DateTime
  createdAt             DateTime                  @default(now())

  vendor              Vendor                       @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  order               CommerceOrder                @relation(fields: [vendorId, orderId], references: [vendorId, id], onDelete: Cascade)
  paymentTransaction  PaymentTransaction?          @relation(fields: [vendorId, paymentTransactionId], references: [vendorId, id], onDelete: Restrict)
  refundRecord        RefundRecord?                @relation("CommerceOrderRefundRecord", fields: [vendorId, refundRecordId], references: [vendorId, id], onDelete: Restrict)
  supportHandoff      SupportRefundHandoff?        @relation("SupportRefundCompletion")
  supportHandoffLinks SupportRefundHandoffRefund[] @relation("CommerceRefundHandoffLinks")

  @@unique([vendorId, id])
  @@unique([vendorId, orderId, id])
  @@unique([vendorId, providerName, eventIdentity])
  @@unique([vendorId, refundRecordId])
  @@index([vendorId, orderId, occurredAt])
  @@index([vendorId, paymentTransactionId])
}

enum SupportCaseStatus {
  open
  in_progress
  waiting_customer
  waiting_finance
  resolved
  closed
}

enum SupportCasePriority {
  p0
  p1
  p2
}

enum SupportCaseCategory {
  payment
  refund
  fulfillment
  access
  general
}

enum SupportCaseEventType {
  created
  note_added
  buyer_reply_added
  customer_reply_added
  status_changed
  assignment_changed
  refund_requested
  refund_review_started
  refund_declined
  refund_completed
}

enum SupportCaseEventAudience {
  internal
  buyer
}

enum SupportRefundHandoffStatus {
  requested
  reviewing
  declined
  completed
}

/// Tenant-scoped support workflow linked to a canonical order. Free-form buyer
/// or staff content lives only in encrypted event envelopes.
model SupportCase {
  id                    String              @id @default(cuid())
  vendorId              String
  orderId               String
  caseNumber            String
  intakeKey             String
  category              SupportCaseCategory
  priority              SupportCasePriority
  status                SupportCaseStatus   @default(open)
  revision              Int                 @default(1)
  createdByMemberId     String?
  createdByBuyerGrantId String?
  assignedMemberId      String?
  firstRespondedAt      DateTime?
  responseDueAt         DateTime
  resolvedAt            DateTime?
  closedAt              DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  vendor              Vendor                  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  order               CommerceOrder           @relation(fields: [vendorId, orderId], references: [vendorId, id], onDelete: Restrict)
  createdBy           VendorMember?           @relation("SupportCaseCreatedBy", fields: [vendorId, createdByMemberId], references: [vendorId, id], onDelete: Restrict)
  createdByBuyerGrant BuyerSupportOrderGrant? @relation("SupportCaseCreatedByBuyer", fields: [vendorId, orderId, createdByBuyerGrantId], references: [vendorId, orderId, id], onDelete: Restrict)
  assignedMember      VendorMember?           @relation("SupportCaseAssignee", fields: [vendorId, assignedMemberId], references: [vendorId, id], onDelete: Restrict)
  events              SupportCaseEvent[]
  refundHandoff       SupportRefundHandoff?

  @@unique([vendorId, id])
  @@unique([vendorId, id, orderId])
  @@unique([vendorId, caseNumber])
  @@unique([vendorId, intakeKey])
  @@index([vendorId, status, priority, updatedAt])
  @@index([vendorId, assignedMemberId, status])
  @@index([vendorId, orderId, createdAt])
  @@index([createdByBuyerGrantId, createdAt])
}

/// Append-only support history. `sanitizedData` contains only bounded workflow
/// metadata; notes and reasons are encrypted with the exact case/event binding.
model SupportCaseEvent {
  id                       String                   @id @default(cuid())
  vendorId                 String
  supportCaseId            String
  dedupKey                 String
  eventType                SupportCaseEventType
  audience                 SupportCaseEventAudience @default(internal)
  actorMemberId            String?
  actorUserId              String?
  actorBuyerOrderId        String?
  actorBuyerGrantId        String?
  payloadEncryptedEnvelope String?
  sanitizedData            Json?
  occurredAt               DateTime                 @default(now())
  createdAt                DateTime                 @default(now())

  vendor        Vendor                  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  supportCase   SupportCase             @relation(fields: [vendorId, supportCaseId], references: [vendorId, id], onDelete: Cascade)
  actor         VendorMember?           @relation("SupportCaseEventActor", fields: [vendorId, actorMemberId], references: [vendorId, id], onDelete: Restrict)
  platformActor User?                   @relation("SupportCaseEventPlatformActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  buyerActor    BuyerSupportOrderGrant? @relation("SupportCaseEventBuyerActor", fields: [vendorId, actorBuyerOrderId, actorBuyerGrantId], references: [vendorId, orderId, id], onDelete: Restrict)

  @@unique([vendorId, id])
  @@unique([vendorId, supportCaseId, dedupKey])
  @@index([vendorId, supportCaseId, occurredAt])
  @@index([vendorId, eventType, occurredAt])
  @@index([actorBuyerGrantId, occurredAt])
}

/// Exact order ownership granted by the checkout response. Public support
/// lookup never accepts an order number or buyer email as proof of ownership.
model BuyerSupportOrderGrant {
  id             String    @id @default(cuid())
  vendorId       String
  orderId        String
  cookieKey      String    @unique
  tokenHash      String    @unique
  expiresAt      DateTime
  revokedAt      DateTime?
  lastAccessedAt DateTime?
  rotationCount  Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  vendor       Vendor             @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  order        CommerceOrder      @relation(fields: [vendorId, orderId], references: [vendorId, id], onDelete: Restrict)
  casesCreated SupportCase[]      @relation("SupportCaseCreatedByBuyer")
  events       SupportCaseEvent[] @relation("SupportCaseEventBuyerActor")

  @@unique([vendorId, orderId])
  @@unique([vendorId, id])
  @@unique([vendorId, orderId, id])
  @@index([vendorId, orderId])
  @@index([expiresAt, revokedAt])
}

/// Merchant-to-finance refund request. It never represents a provider refund;
/// `completed` requires a tenant/order-bound canonical CommerceOrderRefund row.
model SupportRefundHandoff {
  id                      String                     @id @default(cuid())
  vendorId                String
  supportCaseId           String
  orderId                 String
  paymentTransactionId    String
  requestedByMemberId     String
  requestedAmountCents    Int
  reasonEncryptedEnvelope String
  status                  SupportRefundHandoffStatus @default(requested)
  revision                Int                        @default(1)
  completedRefundId       String?
  reviewedByActorId       String?
  reviewedAt              DateTime?
  completedAt             DateTime?
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt

  vendor               Vendor                       @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  supportCase          SupportCase                  @relation(fields: [vendorId, supportCaseId], references: [vendorId, id], onDelete: Restrict)
  order                CommerceOrder                @relation(fields: [vendorId, orderId], references: [vendorId, id], onDelete: Restrict)
  paymentTransaction   PaymentTransaction           @relation(fields: [vendorId, paymentTransactionId], references: [vendorId, id], onDelete: Restrict)
  requestedBy          VendorMember                 @relation("SupportRefundRequestedBy", fields: [vendorId, requestedByMemberId], references: [vendorId, id], onDelete: Restrict)
  reviewedBy           User?                        @relation("SupportRefundReviewedBy", fields: [reviewedByActorId], references: [id], onDelete: Restrict)
  completedRefund      CommerceOrderRefund?         @relation("SupportRefundCompletion", fields: [vendorId, orderId, completedRefundId], references: [vendorId, orderId, id], onDelete: Restrict)
  completedRefundLinks SupportRefundHandoffRefund[] @relation("SupportRefundHandoffCompletionLinks")

  @@unique([vendorId, id])
  @@unique([vendorId, supportCaseId])
  @@unique([vendorId, completedRefundId])
  @@unique([vendorId, orderId, completedRefundId])
  @@index([status, createdAt])
  @@index([vendorId, orderId, status])
  @@index([vendorId, paymentTransactionId])
}

/// Immutable, tenant/order-bound refund references used to prove that one or
/// more processed canonical refunds exactly satisfy a support handoff.
model SupportRefundHandoffRefund {
  vendorId            String
  handoffId           String
  orderId             String
  refundId            String
  amountCentsSnapshot Int
  linkedAt            DateTime @default(now())

  handoff SupportRefundHandoff @relation("SupportRefundHandoffCompletionLinks", fields: [vendorId, handoffId], references: [vendorId, id], onDelete: Restrict)
  refund  CommerceOrderRefund  @relation("CommerceRefundHandoffLinks", fields: [vendorId, orderId, refundId], references: [vendorId, orderId, id], onDelete: Restrict)

  @@id([vendorId, handoffId, refundId])
  @@unique([vendorId, refundId])
  @@index([vendorId, handoffId, linkedAt])
}

/// Vendor-scoped record of an explicitly confirmed public HTTPS delivery host
/// and path. It is copied into each order snapshot and is never a provider
/// credential store.
model VendorDeliveryUrlAllowlist {
  id         String   @id @default(cuid())
  vendorId   String
  hostname   String
  pathPrefix String   @default("/")
  allowQuery Boolean  @default(false)
  status     String   @default("active")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  vendor          Vendor                  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  deliveryConfigs ProductDeliveryConfig[]

  @@unique([vendorId, id])
  @@unique([vendorId, hostname, pathPrefix])
  @@index([vendorId, status, updatedAt])
}

/// Current merchant-authored delivery configuration. Sensitive destination and
/// instructions remain encrypted and are not fields on the browser-serialized
/// Product model.
model ProductDeliveryConfig {
  id                            String                      @id @default(cuid())
  vendorId                      String
  productId                     String
  allowlistId                   String?
  revision                      Int                         @default(1)
  status                        ProductDeliveryConfigStatus @default(draft)
  fulfillmentType               CommerceFulfillmentType
  deliveryKind                  ProductDeliveryKind
  title                         String
  destinationEncryptedEnvelope  String?
  destinationMaskedSummary      String?
  instructionsEncryptedEnvelope String?
  instructionsMaskedSummary     String?
  activatedAt                   DateTime?
  disabledAt                    DateTime?
  createdAt                     DateTime                    @default(now())
  updatedAt                     DateTime                    @updatedAt

  vendor    Vendor                      @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  product   Product                     @relation(fields: [vendorId, productId], references: [vendorId, id], onDelete: Cascade)
  allowlist VendorDeliveryUrlAllowlist? @relation(fields: [vendorId, allowlistId], references: [vendorId, id], onDelete: Restrict)

  @@unique([vendorId, id])
  @@unique([vendorId, productId])
  @@index([vendorId, status, updatedAt])
  @@index([vendorId, allowlistId])
}

/// Immutable buyer-delivery terms captured with the order item. Product edits
/// never rewrite this encrypted snapshot.
model CommerceOrderItemDeliverySnapshot {
  id                            String                  @id @default(cuid())
  vendorId                      String
  orderId                       String
  orderItemId                   String
  productDeliveryConfigId       String?
  productDeliveryConfigRevision Int?
  fulfillmentType               CommerceFulfillmentType
  deliveryKind                  ProductDeliveryKind
  title                         String
  destinationEncryptedEnvelope  String?
  destinationMaskedSummary      String?
  instructionsEncryptedEnvelope String?
  instructionsMaskedSummary     String?
  allowlistSnapshot             Json?
  createdAt                     DateTime                @default(now())
  revokedAt                     DateTime?

  vendor    Vendor            @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  order     CommerceOrder     @relation(fields: [vendorId, orderId], references: [vendorId, id], onDelete: Cascade)
  orderItem CommerceOrderItem @relation(fields: [vendorId, orderId, orderItemId], references: [vendorId, orderId, id], onDelete: Cascade)

  @@unique([vendorId, id])
  @@unique([vendorId, orderId, orderItemId])
  @@index([vendorId, orderId, createdAt])
}

model ShippingFulfillment {
  id             String                    @id @default(cuid())
  vendorId       String
  orderItemId    String
  revision       Int                       @default(1)
  status         ShippingFulfillmentStatus @default(pending)
  carrierName    String?
  trackingNumber String?
  trackingUrl    String?
  packingAt      DateTime?
  shippedAt      DateTime?
  refundReviewAt DateTime?
  deliveredAt    DateTime?
  returnedAt     DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  vendor    Vendor            @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  orderItem CommerceOrderItem @relation(fields: [vendorId, orderItemId], references: [vendorId, id], onDelete: Cascade)

  @@unique([vendorId, id])
  @@unique([vendorId, orderItemId])
  @@index([vendorId, status, updatedAt])
  @@index([trackingNumber])
}

model CommerceEntitlement {
  id                      String                    @id @default(cuid())
  vendorId                String
  orderItemId             String
  revision                Int                       @default(1)
  status                  CommerceEntitlementStatus @default(pending)
  accessEncryptedEnvelope String?
  accessMaskedSummary     String?
  grantedAt               DateTime?
  expiresAt               DateTime?
  revokedAt               DateTime?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt

  vendor    Vendor            @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  orderItem CommerceOrderItem @relation(fields: [vendorId, orderItemId], references: [vendorId, id], onDelete: Cascade)

  @@unique([vendorId, id])
  @@unique([vendorId, orderItemId])
  @@index([vendorId, status, expiresAt])
}

model ServiceFulfillment {
  id                       String                   @id @default(cuid())
  vendorId                 String
  orderItemId              String
  revision                 Int                      @default(1)
  status                   ServiceFulfillmentStatus @default(pending)
  scheduledAt              DateTime?
  completedAt              DateTime?
  cancelledAt              DateTime?
  serviceEncryptedEnvelope String?
  serviceMaskedSummary     String?
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt

  vendor    Vendor            @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  orderItem CommerceOrderItem @relation(fields: [vendorId, orderItemId], references: [vendorId, id], onDelete: Cascade)

  @@unique([vendorId, id])
  @@unique([vendorId, orderItemId])
  @@index([vendorId, status, scheduledAt])
}

model InventoryReservation {
  id                   String    @id @default(cuid())
  vendorId             String
  productId            String
  paymentTransactionId String    @unique
  quantity             Int       @default(1)
  status               String    @default("reserved")
  expiresAt            DateTime
  committedAt          DateTime?
  releasedAt           DateTime?
  releaseReason        String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  vendor             Vendor             @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  product            Product            @relation(fields: [vendorId, productId], references: [vendorId, id], onDelete: Cascade)
  paymentTransaction PaymentTransaction @relation(fields: [vendorId, paymentTransactionId], references: [vendorId, id], onDelete: Cascade)

  @@unique([vendorId, paymentTransactionId])
  @@index([vendorId, status, expiresAt])
  @@index([productId, status])
}

model WebhookEvent {
  id           String    @id @default(cuid())
  vendorId     String?
  provider     String
  eventId      String
  eventType    String
  status       String    @default("received")
  payload      Json
  errorMessage String?
  processedAt  DateTime?
  retryCount   Int       @default(0)
  maxRetries   Int       @default(5)
  nextRetryAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  vendor Vendor? @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  @@unique([provider, eventId])
  @@index([status, createdAt])
  @@index([vendorId, createdAt])
}

model RefundRecord {
  id                     String   @id @default(cuid())
  vendorId               String
  paymentTransactionId   String
  providerEventId        String?
  monthKey               String
  refundAmountCents      Int
  gatewayFeeRefundCents  Int      @default(0)
  platformFeeRefundCents Int      @default(0)
  reason                 String?
  status                 String   @default("processed")
  processedAt            DateTime @default(now())
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  vendor              Vendor               @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  paymentTransaction  PaymentTransaction   @relation(fields: [vendorId, paymentTransactionId], references: [vendorId, id], onDelete: Cascade)
  commerceOrderRefund CommerceOrderRefund? @relation("CommerceOrderRefundRecord")

  @@unique([vendorId, id])
  @@index([vendorId, monthKey])
  @@index([paymentTransactionId, processedAt])
  @@index([paymentTransactionId, providerEventId])
}

model AuditLog {
  id         String   @id @default(cuid())
  vendorId   String?
  actorId    String?
  actorLabel String?
  action     String
  targetType String
  targetId   String?
  before     Json?
  after      Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  vendor Vendor? @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  @@index([vendorId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
}

model AffiliateCommission {
  id                        String                    @id @default(cuid())
  vendorId                  String
  affiliateId               String?
  monthKey                  String
  sourceType                String                    @default("product")
  sourceId                  String?
  deduplicationKey          String
  referralCode              String?
  orderNumber               String?
  orderAmountCents          Int                       @default(0)
  commissionBaseAmountCents Int                       @default(0)
  netReferenceAmountCents   Int                       @default(0)
  commissionRateBps         Int                       @default(0)
  commissionAmountCents     Int                       @default(0)
  currency                  String                    @default("TWD")
  recipientRole             String                    @default("promoter")
  uplineLevel               Int?
  commissionRuleSetId       String?
  commissionRuleVersion     Int?
  monthlySalesBeforeCents   Int?
  monthlySalesAfterCents    Int?
  status                    AffiliateCommissionStatus @default(pending)
  attributedAt              DateTime                  @default(now())
  settledAt                 DateTime?
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt

  vendor            Vendor                           @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  affiliate         Affiliate?                       @relation(fields: [vendorId, affiliateId], references: [vendorId, id], onDelete: Restrict)
  commissionRuleSet CommissionRuleSet?               @relation(fields: [vendorId, commissionRuleSetId], references: [vendorId, id], onDelete: Restrict)
  ledgerEntries     AffiliateCommissionLedgerEntry[]

  @@unique([vendorId, id])
  @@unique([vendorId, deduplicationKey])
  @@index([vendorId, monthKey])
  @@index([affiliateId, status])
  @@index([vendorId, sourceId, recipientRole])
  @@index([vendorId, commissionRuleSetId])
}

enum CommissionRuleStatus {
  ACTIVE
  ARCHIVED
}

/// Versioned merchant-owned policy. Saving a policy creates a new row so paid
/// orders can retain their exact policy reference forever.
model CommissionRuleSet {
  id              String               @id @default(cuid())
  vendorId        String
  name            String
  version         Int
  status          CommissionRuleStatus @default(ACTIVE)
  maxTotalRateBps Int
  currency        String               @default("TWD")
  activatedAt     DateTime             @default(now())
  archivedAt      DateTime?
  createdAt       DateTime             @default(now())

  vendor       Vendor                  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  tiers        CommissionRateTier[]
  uplineLevels CommissionUplineLevel[]
  commissions  AffiliateCommission[]

  @@unique([vendorId, id])
  @@unique([vendorId, version])
  @@index([vendorId, status, activatedAt])
}

model CommissionRateTier {
  id                   String @id @default(cuid())
  vendorId             String
  commissionRuleSetId  String
  minMonthlySalesCents Int
  rateBps              Int

  vendor  Vendor            @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  ruleSet CommissionRuleSet @relation(fields: [vendorId, commissionRuleSetId], references: [vendorId, id], onDelete: Cascade)

  @@unique([commissionRuleSetId, minMonthlySalesCents])
  @@index([vendorId, commissionRuleSetId, minMonthlySalesCents])
}

model CommissionUplineLevel {
  id                  String @id @default(cuid())
  vendorId            String
  commissionRuleSetId String
  level               Int
  bonusRateBps        Int

  vendor  Vendor            @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  ruleSet CommissionRuleSet @relation(fields: [vendorId, commissionRuleSetId], references: [vendorId, id], onDelete: Cascade)

  @@unique([commissionRuleSetId, level])
  @@index([vendorId, commissionRuleSetId, level])
}

/// Immutable accounting entries. Operational commission status remains separate
/// from its financial balance so a paid commission is never rewritten after payout.
model AffiliateCommissionLedgerEntry {
  id                    String                             @id @default(cuid())
  vendorId              String
  affiliateCommissionId String
  entryType             AffiliateCommissionLedgerEntryType
  deduplicationKey      String
  providerName          String
  eventIdentity         String
  disputeCaseId         String?
  amountCents           Int
  occurredAt            DateTime
  createdAt             DateTime                           @default(now())

  vendor     Vendor              @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  commission AffiliateCommission @relation(fields: [vendorId, affiliateCommissionId], references: [vendorId, id], onDelete: Restrict)

  @@unique([vendorId, deduplicationKey])
  @@index([vendorId, affiliateCommissionId, createdAt], map: "AffiliateCommissionLedger_v_c_created_idx")
  @@index([vendorId, affiliateCommissionId, disputeCaseId], map: "AffiliateCommissionLedger_v_c_case_idx")
