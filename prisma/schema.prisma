// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum StreamUsageReconciliationStatus {
  MATCHED
  MISMATCH
  RESOLVED
}

enum StreamUsageReconciliationResolution {
  ACCEPT_INTERNAL
  ACCEPT_PROVIDER
  ESCALATED
}

enum StreamUsageReconciliationEvidenceKind {
  ADMIN_ATTESTED_DIGEST
}

enum StreamOperationsAlertType {
  QUOTA_WARNING
  QUOTA_EXHAUSTED
  PROVIDER_DISCREPANCY
}

enum StreamOperationsAlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum StreamOperationsAlertSeverity {
  WARNING
  CRITICAL
}

model Vendor {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  email        String   @unique
  passwordHash String
  logoUrl      String?
  primaryColor String   @default("#2563eb")
  ctaColor     String   @default("#f97316")
  timezone     String   @default("Asia/Taipei")
  supportEmail String?
  senderName   String?
  contactUrl   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  members                          VendorMember[]
  tracking                         TrackingSetting?
  videos                           Video[]
  products                         Product[]
  deliveryUrlAllowlist             VendorDeliveryUrlAllowlist[]
  productDeliveryConfigs           ProductDeliveryConfig[]
  commerceDeliverySnapshots        CommerceOrderItemDeliverySnapshot[]
  forms                            RegistrationForm[]
  lives                            Live[]
  templates                        MessageTemplate[]
  analytics                        AnalyticsEvent[]
  interactionScripts               InteractionScript[]
  interactionRoles                 InteractionRole[]
  blacklists                       Blacklist[]
  affiliates                       Affiliate[]
  affiliateClicks                  AffiliateClick[]
  affiliateCommissions             AffiliateCommission[]
  affiliateCommissionLedgerEntries AffiliateCommissionLedgerEntry[]
  affiliatePayouts                 AffiliatePayout[]
  commissionRuleSets               CommissionRuleSet[]
  commissionRateTiers              CommissionRateTier[]
  commissionUplineLevels           CommissionUplineLevel[]
  courseCommissionAllocations      CourseCommissionAllocation[]
  courseCommissionLedgerEntries    CourseCommissionLedgerEntry[]
  coursePayouts                    CoursePayout[]
  usageRecords                     UsageRecord[]
  usageLimit                       VendorUsageLimit?
  subscriptions                    VendorSubscription[]
  invoices                         Invoice[]
  settlements                      Settlement[]
  payoutItems                      PayoutItem[]
  paymentAccounts                  PaymentAccount[]
  paymentMethodReferences          PaymentMethodReference[]
  paymentTransactions              PaymentTransaction[]
  inventoryReservations            InventoryReservation[]
  refundRecords                    RefundRecord[]
  commerceOrders                   CommerceOrder[]
  commerceOrderItems               CommerceOrderItem[]
  commerceOrderEvents              CommerceOrderEvent[]
  commerceOrderRefunds             CommerceOrderRefund[]
  shippingFulfillments             ShippingFulfillment[]
  commerceEntitlements             CommerceEntitlement[]
  serviceFulfillments              ServiceFulfillment[]
  auditLogs                        AuditLog[]
  webhookEvents                    WebhookEvent[]
  sessions                         UserSession[]
  salesTeams                       SalesTeam[]
  teamTemplates                    TeamFunnelTemplate[]
  teamTemplateVersions             TeamFunnelTemplateVersion[]
  partnerFunnelPages               PartnerFunnelPage[]
  partnerLiveShares                PartnerLiveShare[]
  teamClickAttributions            TeamClickAttribution[]
  teamLeadAttributions             TeamLeadAttribution[]
  teamConversionAttributions       TeamConversionAttribution[]
  streamUsageLedgerEntries         StreamUsageLedgerEntry[]
  streamUsageAllocations           StreamUsageAllocationEntry[]
  streamUsageReconciliations       StreamUsageReconciliation[]
  streamOperationsAlerts           StreamOperationsAlert[]
  liveViewerSessions               LiveViewerSession[]
  platformReferralCommissions      PlatformReferralCommission[]
  liveProducts                     LiveProduct[]
  imageAssets                      ImageAsset[]
  liveStudioDrafts                 LiveStudioDraft[]
  emailDeliveries                  EmailDelivery[]
  liveReminderReconciliationJobs   LiveReminderReconciliationJob[]
  liveChatMessages                 LiveChatMessage[]
  liveNotificationRules            LiveNotificationRule[]
  emailSuppressions                EmailSuppression[]
  lineOfficialAccount              LineOfficialAccount?
  lineUserIdentities               LineUserIdentity[]
  lineLoginStates                  LineLoginState[]
  lineDeliveries                   LineDelivery[]
  supportCases                     SupportCase[]
  supportCaseEvents                SupportCaseEvent[]
  supportRefundHandoffs            SupportRefundHandoff[]
  buyerSupportOrderGrants          BuyerSupportOrderGrant[]
  liveInteractionRuns              LiveInteractionRun[]
  liveInteractionResponses         LiveInteractionResponse[]
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  platformRole String    @default("none")
  status       String    @default("active")
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  supportCaseEventsReviewed SupportCaseEvent[]     @relation("SupportCaseEventPlatformActor")
  supportRefundsReviewed    SupportRefundHandoff[] @relation("SupportRefundReviewedBy")

  memberships                  VendorMember[]
  sessions                     UserSession[]
  passwordResetTokens          PasswordResetToken[]
  mfaFactor                    UserMfaFactor?
  recoveryCodes                UserRecoveryCode[]
  platformReferralCodes        PlatformReferralCode[]
  platformReferralAttributions PlatformReferralAttribution[]
  platformReferralCommissions  PlatformReferralCommission[]
  platformReferralPayouts      PlatformReferralPayout[]
  affiliatePortals             Affiliate[]
}

model UserSession {
  id            String    @id @default(cuid())
  userId        String
  vendorId      String?
  tokenHash     String    @unique
  ipAddress     String?
  userAgent     String?
  mfaVerifiedAt DateTime?
  expiresAt     DateTime
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendor Vendor? @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  @@index([userId, expiresAt])
  @@index([vendorId, expiresAt])
  @@index([expiresAt])
}

model UserMfaFactor {
  id              String    @id @default(cuid())
  userId          String    @unique
  factorType      String    @default("totp")
  label           String?
  secretEncrypted String
  enabledAt       DateTime  @default(now())
  lastUsedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([factorType, enabledAt])
}

model UserRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  ipAddress String?
  userAgent String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model VendorMember {
  id            String    @id @default(cuid())
  vendorId      String
  userId        String
  role          String    @default("owner")
  status        String    @default("active")
  deactivatedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  teamMemberships             TeamMembership[]
  createdTeamTemplateVersions TeamFunnelTemplateVersion[]   @relation("TeamTemplateVersionCreatedBy")
  templateFieldLocks          TeamFunnelTemplateFieldLock[]
  supportCasesCreated         SupportCase[]                 @relation("SupportCaseCreatedBy")
  supportCasesAssigned        SupportCase[]                 @relation("SupportCaseAssignee")
  supportCaseEvents           SupportCaseEvent[]            @relation("SupportCaseEventActor")
  supportRefundsRequested     SupportRefundHandoff[]        @relation("SupportRefundRequestedBy")

  @@unique([vendorId, userId])
  @@unique([vendorId, id])
  @@index([vendorId, status])
}

model TrackingSetting {
  id                  String   @id @default(cuid())
  vendorId            String   @unique
  facebookPixelId     String?
  tiktokPixelId       String?
  googleTagManagerId  String?
  enablePageView      Boolean  @default(true)
  enableLeadEvent     Boolean  @default(true)
  enablePurchaseEvent Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
}

model Video {
  id                      String   @id @default(cuid())
  vendorId                String
  title                   String
  description             String?
  sourceType              String   @default("cloudflare_stream")
  videoUrl                String
  thumbnailUrl            String?
  thumbnailAssetId        String?
  durationSec             Int      @default(0)
  status                  String   @default("ready")
  cloudflareStreamUid     String?
  cloudflareLiveInputUid  String?
  cloudflarePlaybackId    String?
  cloudflareReadyToStream Boolean  @default(false)
  liveStreamKey           String?
  liveInputStatus         String?
  estimatedMinutes        Int      @default(0)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  vendor                      Vendor             @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  thumbnailAsset              ImageAsset?        @relation("VideoThumbnailImageAsset", fields: [vendorId, thumbnailAssetId], references: [vendorId, id], onDelete: Restrict)
  archiveState                VideoArchiveState?
  lives                       Live[]
  registrationFormPromoVideos RegistrationForm[] @relation("RegistrationFormPromoVideo")

  @@unique([vendorId, id])
  @@index([thumbnailAssetId])
}

/// Durable tenant-scoped state used to restore a video to the provider/local
/// status it had immediately before a soft archive.
model VideoArchiveState {
  id             String   @id @default(cuid())
  vendorId       String
  videoId        String
  previousStatus String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  video Video @relation(fields: [vendorId, videoId], references: [vendorId, id], onDelete: Cascade)

  @@unique([vendorId, videoId])
  @@index([vendorId, previousStatus])
}

model Product {
  id                             String                  @id @default(cuid())
  vendorId                       String
  name                           String
  slug                           String
  description                    String?
  priceCents                     Int
  compareAtCents                 Int?
  currency                       String                  @default("TWD")
  imageUrl                       String?
  imageAssetId                   String?
  checkoutUrl                    String?
  customCheckoutFields           Json?
  inventory                      Int                     @default(0)
  isActive                       Boolean                 @default(true)
  commerceDomain                 String                  @default("merchant")
  fulfillmentType                CommerceFulfillmentType @default(physical)
  fulfillmentTypeConfirmed       Boolean                 @default(true)
  courseContentOwnerMembershipId String?
  coursePromoterShareBps         Int?
  coursePolicyVersion            Int                     @default(1)
  revision                       Int                     @default(1)
  createdAt                      DateTime                @default(now())
  updatedAt                      DateTime                @updatedAt

  vendor                      Vendor                          @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  imageAsset                  ImageAsset?                     @relation("ProductImageAsset", fields: [vendorId, imageAssetId], references: [vendorId, id], onDelete: Restrict)
  courseContentOwner          TeamMembership?                 @relation("CourseProductContentOwner", fields: [vendorId, courseContentOwnerMembershipId], references: [vendorId, id], onDelete: Restrict)
  liveProducts                LiveProduct[]
  templateProductSlots        TeamFunnelTemplateProductSlot[]
  partnerProductOverrides     PartnerProductSlotOverride[]
  inventoryReservations       InventoryReservation[]
  courseCommissionAllocations CourseCommissionAllocation[]
  commerceOrderItems          CommerceOrderItem[]
  deliveryConfig              ProductDeliveryConfig?

  @@unique([vendorId, id])
  @@unique([vendorId, slug])
  @@index([vendorId, commerceDomain, isActive])
  @@index([vendorId, fulfillmentType, isActive])
  @@index([imageAssetId])
}

model RegistrationForm {
  id                     String   @id @default(cuid())
  vendorId               String
  name                   String
  slug                   String   @unique
  headline               String
  description            String?
  submitLabel            String   @default("送出報名")
  fields                 Json
  successMessage         String   @default("已收到你的資料，開播前會再提醒你。")
  heroImageUrl           String?
  heroImageAssetId       String?
  backgroundImageUrl     String?
  backgroundImageAssetId String?
  promoVideoId           String?
  themeColor             String?
  countdownMinutes       Int?
  stickyText             String?
  bodyContent            String?
  notice                 String?
  seoTitle               String?
  seoDescription         String?
  maxVisibleSessions     Int      @default(0)
  hideExpiredSessions    Boolean  @default(true)
  isActive               Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  vendor               Vendor           @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  heroImageAsset       ImageAsset?      @relation("RegistrationFormHeroImageAsset", fields: [vendorId, heroImageAssetId], references: [vendorId, id], onDelete: Restrict)
  backgroundImageAsset ImageAsset?      @relation("RegistrationFormBackgroundImageAsset", fields: [vendorId, backgroundImageAssetId], references: [vendorId, id], onDelete: Restrict)
  promoVideo           Video?           @relation("RegistrationFormPromoVideo", fields: [vendorId, promoVideoId], references: [vendorId, id], onDelete: Restrict)
  submissions          FormSubmission[]
  lives                Live[]

  @@unique([vendorId, id])
}

model FormSubmission {
  id                    String                           @id @default(cuid())
  formId                String
  liveId                String?
  name                  String
  email                 String
  phone                 String?
  answers               Json?
  source                String                           @default("form")
  verificationStatus    FormSubmissionVerificationStatus @default(UNVERIFIED)
  verificationVersion   Int                              @default(1)
  verificationExpiresAt DateTime?
  verifiedAt            DateTime?
  affiliateClickId      String?
  createdAt             DateTime                         @default(now())

  form            RegistrationForm     @relation(fields: [formId], references: [id], onDelete: Cascade)
  live            Live?                @relation(fields: [liveId], references: [id], onDelete: SetNull)
  affiliateClick  AffiliateClick?      @relation(fields: [affiliateClickId], references: [id], onDelete: SetNull)
  teamAttribution TeamLeadAttribution?
  chatMessages    LiveChatMessage[]

  @@unique([liveId, id])
  @@index([formId, verificationStatus, createdAt])
  @@index([liveId, verificationStatus, createdAt])
  @@index([affiliateClickId])
}

enum FormSubmissionVerificationStatus {
  UNVERIFIED
  VERIFIED
}

model Live {
  id                        String    @id @default(cuid())
  vendorId                  String
  videoId                   String?
  formId                    String?
  messageTemplateId         String?
  liveReminderTemplateId    String?
  liveReminderOffsetMinutes Int       @default(60)
  interactionScriptId       String?
  teamId                    String?
  seminarOwnerMembershipId  String?
  title                     String
  slug                      String    @unique
  description               String?
  scheduledAt               DateTime
  status                    String    @default("draft")
  startedAt                 DateTime?
  endedAt                   DateTime?
  replayAvailableUntil      DateTime?
  heroImageUrl              String?
  heroImageAssetId          String?
  accentCopy                String?
  replayEnabled             Boolean   @default(true)
  streamMode                String    @default("vod")
  cloudflareLiveInputUid    String?
  quotaPolicy               Json?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  vendor                     Vendor                          @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  heroImageAsset             ImageAsset?                     @relation("LiveHeroImageAsset", fields: [vendorId, heroImageAssetId], references: [vendorId, id], onDelete: Restrict)
  video                      Video?                          @relation(fields: [videoId], references: [id], onDelete: SetNull)
  form                       RegistrationForm?               @relation(fields: [formId], references: [id], onDelete: SetNull)
  messageTemplate            MessageTemplate?                @relation("LiveRegistrationTemplate", fields: [messageTemplateId], references: [id], onDelete: SetNull)
  liveReminderTemplate       MessageTemplate?                @relation("LiveReminderTemplate", fields: [vendorId, liveReminderTemplateId], references: [vendorId, id], onDelete: Restrict)
  interactionScript          InteractionScript?              @relation(fields: [interactionScriptId], references: [id], onDelete: SetNull)
  team                       SalesTeam?                      @relation(fields: [vendorId, teamId], references: [vendorId, id], onDelete: Restrict)
  seminarOwner               TeamMembership?                 @relation("LiveSeminarOwner", fields: [teamId, seminarOwnerMembershipId], references: [teamId, id], onDelete: Restrict)
  products                   LiveProduct[]
  submissions                FormSubmission[]
  analytics                  AnalyticsEvent[]
  affiliateClicks            AffiliateClick[]
  partnerFunnelPages         PartnerFunnelPage[]
  partnerLiveShares          PartnerLiveShare[]
  streamUsageLedgerEntries   StreamUsageLedgerEntry[]
  streamUsageAllocations     StreamUsageAllocationEntry[]
  viewerSessions             LiveViewerSession[]
  studioDrafts               LiveStudioDraft[]
  reminderReconciliationJobs LiveReminderReconciliationJob[]
  liveChatMessages           LiveChatMessage[]
  notificationRules          LiveNotificationRule[]
  interactionRuns            LiveInteractionRun[]
  interactionResponses       LiveInteractionResponse[]

  @@unique([vendorId, id])
  @@index([heroImageAssetId])
  @@index([vendorId, status, replayAvailableUntil])
}

/// Tenant-owned image upload metadata. Object keys are generated server-side
/// and only transition to ready after R2 HEAD verification.
model ImageAsset {
  id               String   @id @default(cuid())
  vendorId         String
  objectKey        String   @unique
  originalFilename String
  mimeType         String
  sizeBytes        Int
  publicUrl        String
  status           String   @default("pending")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  vendor                           Vendor             @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  productImages                    Product[]          @relation("ProductImageAsset")
  liveHeroImages                   Live[]             @relation("LiveHeroImageAsset")
  videoThumbnails                  Video[]            @relation("VideoThumbnailImageAsset")
  registrationFormHeroImages       RegistrationForm[] @relation("RegistrationFormHeroImageAsset")
  registrationFormBackgroundImages RegistrationForm[] @relation("RegistrationFormBackgroundImageAsset")

  @@unique([vendorId, id])
  @@index([vendorId, status, createdAt])
}

/// Server-side, tenant-owned Live Studio recovery snapshots. Revision is used
/// for optimistic concurrency so another browser tab cannot silently overwrite
/// a newer draft.
model LiveStudioDraft {
  id                String    @id @default(cuid())
  vendorId          String
  liveId            String?
  payload           Json
  revision          Int       @default(1)
  updatedByMemberId String
  expiresAt         DateTime
  consumedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  live   Live?  @relation(fields: [liveId], references: [id], onDelete: SetNull)

  @@unique([vendorId, id])
  @@unique([vendorId, liveId])
  @@index([vendorId, consumedAt, expiresAt, updatedAt])
}

/// Short-lived opaque viewer admission state used for server-side concurrent
/// viewer limits. The raw browser token is never persisted.
model LiveViewerSession {
  id         String   @id @default(cuid())
  vendorId   String
  liveId     String
  tokenHash  String   @unique
  lastSeenAt DateTime
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  live   Live   @relation(fields: [vendorId, liveId], references: [vendorId, id], onDelete: Cascade)

  @@index([vendorId, liveId, expiresAt])
  @@index([liveId, expiresAt])
}

model LiveProduct {
  id              String  @id @default(cuid())
  vendorId        String
  liveId          String
  productId       String
  sortOrder       Int     @default(0)
  offerLabel      String?
  offerPriceCents Int?
  isPinned        Boolean @default(false)
  isVisible       Boolean @default(true)

  vendor  Vendor  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  live    Live    @relation(fields: [vendorId, liveId], references: [vendorId, id], onDelete: Cascade)
  product Product @relation(fields: [vendorId, productId], references: [vendorId, id], onDelete: Cascade)

  @@unique([vendorId, liveId, productId])
  @@index([vendorId, liveId, sortOrder])
  @@index([vendorId, liveId, isVisible, sortOrder])
}

model MessageTemplate {
  id        String   @id @default(cuid())
  vendorId  String
  name      String
  channel   String   @default("email")
  trigger   String   @default("registration_confirmed")
  subject   String?
  body      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vendor            Vendor                 @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  lives             Live[]                 @relation("LiveRegistrationTemplate")
  reminderLives     Live[]                 @relation("LiveReminderTemplate")
  notificationRules LiveNotificationRule[] @relation("LiveNotificationRuleTemplate")
  lineDeliveries    LineDelivery[]

  @@unique([vendorId, id])
}

/// A tenant-owned LINE channel connection. Every provider credential, including
/// channel identifiers, is encrypted at rest with a vendor/field-specific AES-GCM key.
model LineOfficialAccount {
  id                              String    @id @default(cuid())
  vendorId                        String    @unique
  messagingChannelIdEncrypted     String
  messagingChannelSecretEncrypted String
  messagingAccessTokenEncrypted   String
  loginChannelIdEncrypted         String?
  loginChannelSecretEncrypted     String?
  status                          String    @default("active")
  connectedAt                     DateTime  @default(now())
  lastValidatedAt                 DateTime?
  createdAt                       DateTime  @default(now())
  updatedAt                       DateTime  @updatedAt

  vendor     Vendor         @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  deliveries LineDelivery[]

  @@unique([vendorId, id])
  @@index([status, updatedAt])
}

/// Tenant-scoped LINE identity for a buyer (FormSubmission) or promoter
/// (Affiliate/User). subjectType + subjectId is validated against the live domain
/// record before linking; the provider user id is never stored as plaintext.
model LineUserIdentity {
  id                    String    @id @default(cuid())
  vendorId              String
  subjectType           String
  subjectId             String
  lineUserIdHash        String
  lineUserIdEncrypted   String
  displayNameEncrypted  String?
  pictureUrlEncrypted   String?
  linkedAt              DateTime  @default(now())
  lastMaterializedAt    DateTime?
  materializationCursor String?
  revokedAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  vendor     Vendor         @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  deliveries LineDelivery[]

  @@unique([vendorId, subjectType, subjectId])
  @@unique([vendorId, lineUserIdHash])
  @@unique([vendorId, id])
  @@index([vendorId, subjectType, revokedAt])
  @@index([revokedAt, lastMaterializedAt])
}

/// One-time OAuth state. Only the hash is persisted so a database read cannot be
/// turned into a usable login callback token.
model LineLoginState {
  id                    String    @id @default(cuid())
  vendorId              String
  stateHash             String    @unique
  nonceHash             String
  codeVerifierEncrypted String
  subjectType           String
  subjectId             String
  redirectPath          String
  expiresAt             DateTime
  consumedAt            DateTime?
  createdAt             DateTime  @default(now())

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId, expiresAt, consumedAt])
}

/// Durable outbox record for LINE pushes. The tenant idempotency key is unique,
/// making event retries safe even when provider responses are ambiguous.
model LineDelivery {
  id                    String    @id @default(cuid())
  vendorId              String
  lineOfficialAccountId String
  lineUserIdentityId    String
  sourceTemplateId      String?
  trigger               String
  idempotencyKey        String
  payloadEncrypted      String
  status                String    @default("queued")
  attemptCount          Int       @default(0)
  maxAttempts           Int       @default(5)
  nextAttemptAt         DateTime?
  claimedAt             DateTime?
  sentAt                DateTime?
  lastErrorCode         String?
  providerRequestId     String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  vendor         Vendor              @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  account        LineOfficialAccount @relation(fields: [vendorId, lineOfficialAccountId], references: [vendorId, id], onDelete: Restrict)
  identity       LineUserIdentity    @relation(fields: [vendorId, lineUserIdentityId], references: [vendorId, id], onDelete: Restrict)
  sourceTemplate MessageTemplate?    @relation(fields: [vendorId, sourceTemplateId], references: [vendorId, id], onDelete: Restrict)

  @@unique([vendorId, idempotencyKey])
  @@index([status, nextAttemptAt, claimedAt])
  @@index([vendorId, trigger, createdAt])
  @@index([lineUserIdentityId, createdAt])
}

model LiveChatMessage {
  id               String   @id @default(cuid())
  vendorId         String
  liveId           String
  formSubmissionId String?
  roleId           String?
  authorName       String
  body             String
  source           String   @default("viewer")
  status           String   @default("visible")
  isSimulated      Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  vendor         Vendor           @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  live           Live             @relation(fields: [vendorId, liveId], references: [vendorId, id], onDelete: Cascade)
  formSubmission FormSubmission?  @relation(fields: [liveId, formSubmissionId], references: [liveId, id], onDelete: Restrict)
  role           InteractionRole? @relation(fields: [vendorId, roleId], references: [vendorId, id], onDelete: Restrict)

  @@index([vendorId, liveId, createdAt])
  @@index([liveId, createdAt])
  @@index([vendorId, formSubmissionId, createdAt])
}

model LiveNotificationRule {
  id                String   @id @default(cuid())
  vendorId          String
  liveId            String
  messageTemplateId String
  trigger           String
  offsetMinutes     Int      @default(0)
  sortOrder         Int      @default(0)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  vendor          Vendor          @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  live            Live            @relation(fields: [vendorId, liveId], references: [vendorId, id], onDelete: Cascade)
  messageTemplate MessageTemplate @relation("LiveNotificationRuleTemplate", fields: [vendorId, messageTemplateId], references: [vendorId, id], onDelete: Restrict)

  @@unique([vendorId, liveId, trigger, offsetMinutes, sortOrder])
  @@index([vendorId, liveId, trigger, isActive])
}

/// Immutable delivery snapshot. Recipient addresses are encrypted at rest;
/// list pages only receive the masked projection.
model EmailDelivery {
  id                       String    @id
  vendorId                 String
  sourceTemplateId         String
  sourceLiveId             String?
  sourceFormSubmissionId   String?
  trigger                  String
  payloadEncryptedEnvelope String
  recipientHash            String
  recipientMaskedEmail     String
  idempotencyKey           String
  status                   String    @default("queued")
  attemptCount             Int       @default(0)
  maxAttempts              Int       @default(5)
  nextAttemptAt            DateTime?
  claimedAt                DateTime?
  sentAt                   DateTime?
  failedAt                 DateTime?
  providerMessageId        String?
  lastErrorCode            String?
  manualRetryCount         Int       @default(0)
  lastManualRetryAt        DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([vendorId, idempotencyKey])
  @@index([status, nextAttemptAt])
  @@index([vendorId, createdAt])
  @@index([vendorId, status, createdAt])
  @@index([vendorId, trigger, createdAt])
  @@index([vendorId, recipientHash])
}

/// Durable, tenant-scoped cursor for bringing already verified registrations
/// into line after a live reminder configuration changes. The config digest is
/// immutable so a worker can fail closed when the live changes again mid-run.
model LiveReminderReconciliationJob {
  id                    String    @id @default(cuid())
  vendorId              String
  liveId                String
  liveStatus            String
  configDigest          String
  templateId            String?
  templateRevision      String?
  scheduledAt           DateTime
  reminderOffsetMinutes Int
  lifecycle             String    @default("pending")
  cursorCreatedAt       DateTime?
  cursorId              String?
  scannedCount          Int       @default(0)
  scheduledCount        Int       @default(0)
  supersededCount       Int       @default(0)
  claimedAt             DateTime?
  attemptCount          Int       @default(0)
  maxAttempts           Int       @default(5)
  nextAttemptAt         DateTime?
  lastErrorCode         String?
  completedAt           DateTime?
  supersededAt          DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  live   Live   @relation(fields: [vendorId, liveId], references: [vendorId, id], onDelete: Cascade)

  @@unique([vendorId, liveId, configDigest])
  @@index([lifecycle, nextAttemptAt])
  @@index([vendorId, liveId, lifecycle, createdAt])
}

/// Vendor-scoped do-not-send ledger used by the public unsubscribe flow and
/// checked again immediately before each provider request.
model EmailSuppression {
  id                   String    @id @default(cuid())
  vendorId             String
  recipientHash        String
  recipientMaskedEmail String
  reason               String
  source               String
  suppressedAt         DateTime  @default(now())
  resubscribedAt       DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([vendorId, recipientHash])
  @@index([vendorId, suppressedAt])
}

model AnalyticsEvent {
  id         String              @id @default(cuid())
  vendorId   String
  liveId     String?
  eventType  String
  visitorId  String
  trustLevel AnalyticsTrustLevel @default(LEGACY_UNVERIFIED)
  payload    Json?
  createdAt  DateTime            @default(now())

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  live   Live?  @relation(fields: [liveId], references: [id], onDelete: SetNull)

  @@index([eventType, createdAt])
  @@index([liveId, createdAt])
  @@index([vendorId, trustLevel, eventType, createdAt])
}

enum AnalyticsTrustLevel {
  LEGACY_UNVERIFIED
  ADMITTED_LIVE_SESSION
  VERIFIED_FORM_SUBMISSION
}

model InteractionRole {
  id          String   @id @default(cuid())
  vendorId    String
  name        String
  avatarUrl   String?
  label       String   @default("官方角色")
  roleType    String   @default("official")
  tone        String?
  isActive    Boolean  @default(true)
  isSimulated Boolean  @default(true)
  isScheduled Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vendor       Vendor             @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  events       InteractionEvent[]
  chatMessages LiveChatMessage[]

  @@unique([vendorId, id])
}

model InteractionScript {
  id          String   @id @default(cuid())
  vendorId    String
  name        String
  description String?
  status      String   @default("draft")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vendor Vendor             @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  events InteractionEvent[]
  lives  Live[]
}

model InteractionEvent {
  id          String   @id @default(cuid())
  scriptId    String
  roleId      String?
  eventType   String
  triggerSec  Int      @default(0)
  title       String
  message     String?
  productId   String?
  ctaLabel    String?
  ctaUrl      String?
  metadata    Json?
  isSimulated Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  script InteractionScript @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  role   InteractionRole?  @relation(fields: [roleId], references: [id], onDelete: SetNull)
}

/// One server-authoritative activation of an advanced live interaction. Script
/// activations are idempotent per live/event; manual activations are independent.
model LiveInteractionRun {
  id                String   @id @default(cuid())
  vendorId          String
  liveId            String
  source            String
  sourceEventId     String?
  eventType         String
  title             String
  configuration     Json
  status            String   @default("active")
  startsAt          DateTime @default(now())
  endsAt            DateTime
  winnerResponseId  String?
  createdByMemberId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  vendor    Vendor                    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  live      Live                      @relation(fields: [vendorId, liveId], references: [vendorId, id], onDelete: Cascade)
  responses LiveInteractionResponse[]

  @@unique([liveId, sourceEventId])
  @@unique([vendorId, id])
  @@index([vendorId, liveId, status, endsAt])
}

/// A single viewer's immutable choice/entry/claim for one run. Viewer tokens and
/// voucher bearer tokens are stored only as hashes.
model LiveInteractionResponse {
  id                  String    @id @default(cuid())
  vendorId            String
  liveId              String
  runId               String
  participantHash     String
  eventType           String
  value               String
  displayName         String?
  claimTokenHash      String?   @unique
  productId           String?
  discountAmountCents Int?
  expiresAt           DateTime?
  usedOrderId         String?
  createdAt           DateTime  @default(now())

  vendor Vendor             @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  live   Live               @relation(fields: [vendorId, liveId], references: [vendorId, id], onDelete: Cascade)
  run    LiveInteractionRun @relation(fields: [vendorId, runId], references: [vendorId, id], onDelete: Cascade)

  @@unique([runId, participantHash])
  @@index([vendorId, liveId, eventType, createdAt])
  @@index([usedOrderId])
}

model Blacklist {
  id             String    @id @default(cuid())
  vendorId       String
  identifier     String
  identifierType String    @default("email")
  reason         String
  notes          String?
  isActive       Boolean   @default(true)
  blockedAt      DateTime  @default(now())
  unblockedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId, identifier])
}

model Affiliate {
  id                   String   @id @default(cuid())
  vendorId             String
  userId               String?
  name                 String
  code                 String   @unique
  source               String?
  contactEmail         String?
  commissionRateBps    Int      @default(0)
  isActive             Boolean  @default(true)
  bankAccountEncrypted String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  vendor          Vendor                @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  portalUser      User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  clicks          AffiliateClick[]
  commissions     AffiliateCommission[]
  payouts         AffiliatePayout[]
  teamMemberships TeamMembership[]

  @@unique([vendorId, id])
  @@unique([vendorId, userId])
  @@index([userId, isActive])
}

model AffiliateClick {
  id           String    @id @default(cuid())
  vendorId     String
  affiliateId  String?
  liveId       String?
  referralCode String?
  visitorId    String
  landingPath  String
  convertedAt  DateTime?
  createdAt    DateTime  @default(now())

  vendor          Vendor                @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  affiliate       Affiliate?            @relation(fields: [affiliateId], references: [id], onDelete: SetNull)
  live            Live?                 @relation(fields: [liveId], references: [id], onDelete: SetNull)
  teamAttribution TeamClickAttribution?
  formSubmissions FormSubmission[]

  @@unique([vendorId, id])
  @@index([referralCode, createdAt])
  @@index([liveId, createdAt])
}

model BillingPlan {
  id                              String   @id @default(cuid())
  name                            String
  code                            String   @unique
  monthlyPriceCents               Int      @default(0)
  includedStreamMinutes           Int      @default(0)
  includedStorageMinutes          Int      @default(0)
  includedCredits                 Int      @default(0)
  includedEvents                  Int      @default(0)
  includedAffiliates              Int      @default(0)
  overageCreditCostCents          Int      @default(0)
  overflowWatchHourPriceCents     Int      @default(0)
  overflowEventUnitPriceCents     Int      @default(0)
  overflowAffiliateUnitPriceCents Int      @default(0)
  overflowStorageMinutePriceCents Int      @default(0)
  paymentServiceFeeCents          Int      @default(0)
  transactionFeeRateBps           Int      @default(0)
  affiliateManagementFeeCents     Int      @default(0)
  isActive                        Boolean  @default(true)
  description                     String?
  createdAt                       DateTime @default(now())
  updatedAt                       DateTime @updatedAt

  usageLimits   VendorUsageLimit[]
  subscriptions VendorSubscription[]
}

model VendorSubscription {
  id               String    @id @default(cuid())
  vendorId         String
  planId           String
  paymentMode      String    @default("byo")
  status           String    @default("active")
  customFeeRateBps Int?
  billingCycleDay  Int       @default(5)
  startedAt        DateTime  @default(now())
  endedAt          DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  vendor                      Vendor                       @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  plan                        BillingPlan                  @relation(fields: [planId], references: [id], onDelete: Restrict)
  platformReferralAttribution PlatformReferralAttribution?
  platformReferralCommissions PlatformReferralCommission[]

  @@index([vendorId, status])
}

/// Platform plan referral domain. This is intentionally separate from the
/// vendor-scoped Affiliate / AffiliateCommission models used by merchants.
model PlatformReferralCode {
  id                String   @id @default(cuid())
  ownerUserId       String
  code              String   @unique
  commissionRateBps Int      @default(0)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  owner        User                          @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  clicks       PlatformReferralClick[]
  attributions PlatformReferralAttribution[]

  @@unique([ownerUserId, id])
  @@index([ownerUserId, isActive])
}

model PlatformReferralClick {
  id             String   @id @default(cuid())
  referralCodeId String
  visitorId      String
  landingPath    String
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  referralCode PlatformReferralCode         @relation(fields: [referralCodeId], references: [id], onDelete: Cascade)
  attribution  PlatformReferralAttribution?

  @@unique([referralCodeId, id])
  @@index([visitorId, createdAt])
  @@index([referralCodeId, expiresAt])
}

/// Immutable referral snapshot captured when a vendor selects a plan. It is
/// attribution evidence only; no commission is accrued before payment proof.
model PlatformReferralAttribution {
  id                        String   @id @default(cuid())
  referralCodeId            String
  clickId                   String
  subscriptionId            String   @unique
  ownerUserId               String
  codeSnapshot              String
  commissionRateBpsSnapshot Int
  createdAt                 DateTime @default(now())

  referralCode PlatformReferralCode  @relation(fields: [referralCodeId], references: [id], onDelete: Restrict)
  click        PlatformReferralClick @relation(fields: [referralCodeId, clickId], references: [referralCodeId, id], onDelete: Restrict)
  subscription VendorSubscription    @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  owner        User                  @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)

  @@unique([referralCodeId, clickId])
  @@index([ownerUserId, createdAt])
  @@index([referralCodeId, createdAt])
}

/// Platform referral commission created only after a verified subscription
/// payment webhook. This remains separate from merchant AffiliateCommission.
model PlatformReferralCommission {
  id                        String   @id @default(cuid())
  ownerUserId               String
  vendorId                  String
  subscriptionId            String
  paymentTransactionId      String   @unique
  codeSnapshot              String
  commissionRateBpsSnapshot Int
  grossAmountCents          Int
  commissionAmountCents     Int
  currency                  String
  monthKey                  String
  status                    String   @default("pending")
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  owner              User                                    @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  vendor             Vendor                                  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  subscription       VendorSubscription                      @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  paymentTransaction PaymentTransaction                      @relation(fields: [vendorId, paymentTransactionId], references: [vendorId, id], onDelete: Restrict)
  ledgerEntries      PlatformReferralCommissionLedgerEntry[]

  @@unique([vendorId, id])
  @@unique([vendorId, paymentTransactionId])
  @@unique([subscriptionId])
  @@index([ownerUserId, monthKey])
  @@index([vendorId, monthKey])
}

model PlatformReferralCommissionLedgerEntry {
  id                           String   @id @default(cuid())
  platformReferralCommissionId String
  entryType                    String
  amountCents                  Int
  providerName                 String
  eventIdentity                String
  disputeCaseId                String?
  deduplicationKey             String
  occurredAt                   DateTime
  createdAt                    DateTime @default(now())

  commission PlatformReferralCommission @relation(fields: [platformReferralCommissionId], references: [id], onDelete: Cascade)

  @@unique([platformReferralCommissionId, deduplicationKey])
  @@index([platformReferralCommissionId, disputeCaseId], map: "prc_ledger_comm_dispute_idx")
  @@index([platformReferralCommissionId, createdAt], map: "prc_ledger_comm_created_idx")
}

/// Platform-owned referral payable read model. It aggregates the immutable
/// commission ledger by owner and month; it does not imply external payout.
model PlatformReferralPayout {
  id                    String    @id @default(cuid())
  ownerUserId           String
  monthKey              String
  commissionAmountCents Int       @default(0)
  adjustmentAmountCents Int       @default(0)
  finalAmountCents      Int       @default(0)
  status                String    @default("pending")
  payoutBatchId         String?
  outcomeReference      String?
  outcomeReason         String?
  paidAt                DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  owner       User                         @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  payoutBatch PlatformReferralPayoutBatch? @relation(fields: [payoutBatchId], references: [id], onDelete: SetNull)

  @@unique([ownerUserId, monthKey])
  @@index([ownerUserId, monthKey, status])
  @@index([payoutBatchId, status])
}

/// Platform referral payout batch is a local, auditable grouping only. It
/// never stores bank credentials and does not perform a provider transfer.
model PlatformReferralPayoutBatch {
  id               String    @id @default(cuid())
  batchNumber      String    @unique
  monthKey         String
  batchDate        DateTime
  totalAmountCents Int       @default(0)
  totalCount       Int       @default(0)
  status           String    @default("draft")
  exportedAt       DateTime?
  executedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  payouts PlatformReferralPayout[]

  @@index([monthKey, status])
}

model VendorUsageLimit {
