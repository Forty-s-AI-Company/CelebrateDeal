model PartnerFunnelPage {
  id                       String   @id @default(cuid())
  vendorId                 String
  teamId                   String
  templateVersionId        String
  promoterMembershipId     String
  contentOwnerMembershipId String
  liveId                   String?
  slug                     String   @unique
  headline                 String
  subheadline              String?
  body                     String?
  ctaLabel                 String
  ctaUrl                   String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  vendor                   Vendor                         @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  team                     SalesTeam                      @relation(fields: [vendorId, teamId], references: [vendorId, id], onDelete: Cascade)
  templateVersion          TeamFunnelTemplateVersion      @relation(fields: [teamId, templateVersionId], references: [teamId, id], onDelete: Restrict)
  promoter                 TeamMembership                 @relation("PartnerPagePromoter", fields: [teamId, promoterMembershipId], references: [teamId, id], onDelete: Restrict)
  contentOwner             TeamMembership                 @relation("PartnerPageContentOwner", fields: [teamId, contentOwnerMembershipId], references: [teamId, id], onDelete: Restrict)
  live                     Live?                          @relation(fields: [vendorId, liveId], references: [vendorId, id], onDelete: Restrict)
  sharing                  PartnerFunnelPageShareSetting?
  productOverrides         PartnerProductSlotOverride[]
  clickAttributions        TeamClickAttribution[]
  leadAttributions         TeamLeadAttribution[]
  conversionAttributions   TeamConversionAttribution[]
  streamUsageLedgerEntries StreamUsageLedgerEntry[]
  liveShares               PartnerLiveShare[]

  @@unique([templateVersionId, promoterMembershipId])
  @@unique([vendorId, id])
  @@index([teamId, promoterMembershipId])
}

/// Immutable server-validated playback usage attribution. It is the internal
/// page/member sub-ledger; provider billing evidence must still reconcile it.
model StreamUsageLedgerEntry {
  id                       String   @id @default(cuid())
  vendorId                 String
  liveId                   String
  sourcePageId             String?
  teamId                   String?
  templateVersionId        String?
  promoterMembershipId     String?
  contentOwnerMembershipId String?
  eventId                  String   @unique
  monthKey                 String
  watchSeconds             Int
  source                   String   @default("DIRECT_PLAYBACK")
  policyVersion            Int      @default(2)
  attributionMode          String   @default("PROMOTER")
  capturedAt               DateTime
  createdAt                DateTime @default(now())

  vendor          Vendor                       @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  live            Live                         @relation(fields: [vendorId, liveId], references: [vendorId, id], onDelete: Cascade)
  sourcePage      PartnerFunnelPage?           @relation(fields: [sourcePageId], references: [id], onDelete: Restrict)
  templateVersion TeamFunnelTemplateVersion?   @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)
  promoter        TeamMembership?              @relation("StreamUsagePromoter", fields: [promoterMembershipId], references: [id], onDelete: Restrict)
  contentOwner    TeamMembership?              @relation("StreamUsageContentOwner", fields: [contentOwnerMembershipId], references: [id], onDelete: Restrict)
  allocations     StreamUsageAllocationEntry[]

  @@unique([vendorId, id])
  @@index([vendorId, monthKey])
  @@index([sourcePageId, monthKey])
  @@index([promoterMembershipId, monthKey])
  @@index([liveId, capturedAt])
}

/// Immutable provider-report comparison against the server-owned usage ledger.
/// The source digest identifies a sanitized report, never a raw provider payload.
model StreamUsageReconciliation {
  id                     String                                @id @default(cuid())
  vendorId               String
  provider               String
  monthKey               String
  sourceDigest           String
  sourceReference        String?
  providerWatchMinutes   Int
  providerStorageMinutes Int?
  internalWatchSeconds   Int
  internalWatchMinutes   Int
  differenceMinutes      Int
  status                 StreamUsageReconciliationStatus
  evidenceKind           StreamUsageReconciliationEvidenceKind @default(ADMIN_ATTESTED_DIGEST)
  capturedAt             DateTime
  createdByActorId       String
  createdByActorLabel    String
  resolution             StreamUsageReconciliationResolution?
  resolutionNote         String?
  resolvedByActorId      String?
  resolvedByActorLabel   String?
  resolvedAt             DateTime?
  createdAt              DateTime                              @default(now())
  updatedAt              DateTime                              @updatedAt

  vendor Vendor                  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  alerts StreamOperationsAlert[]

  @@unique([provider, sourceDigest])
  @@unique([vendorId, id])
  @@index([vendorId, monthKey, status])
  @@index([vendorId, provider, monthKey])
}

/// Persistent operational alerts. Deduplication keys contain only server-owned
/// identifiers, so retries do not create alert storms or persist provider data.
model StreamOperationsAlert {
  id                       String                        @id @default(cuid())
  vendorId                 String
  type                     StreamOperationsAlertType
  status                   StreamOperationsAlertStatus   @default(OPEN)
  dedupKey                 String                        @unique
  provider                 String?
  monthKey                 String
  severity                 StreamOperationsAlertSeverity
  message                  String
  reconciliationId         String?
  metadata                 Json?
  acknowledgedByActorId    String?
  acknowledgedByActorLabel String?
  acknowledgedAt           DateTime?
  resolvedByActorId        String?
  resolvedByActorLabel     String?
  resolvedAt               DateTime?
  createdAt                DateTime                      @default(now())
  updatedAt                DateTime                      @updatedAt

  vendor         Vendor                     @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  reconciliation StreamUsageReconciliation? @relation(fields: [vendorId, reconciliationId], references: [vendorId, id], onDelete: Cascade)

  @@index([vendorId, monthKey, status])
  @@index([vendorId, provider, type, status])
  @@index([reconciliationId])
}

/// Immutable internal allocation snapshot for each stream usage heartbeat.
/// Provider billing remains vendor-level; this child ledger is the auditable
/// member/page attribution read model and is created with its parent entry.
model StreamUsageAllocationEntry {
  id                    String   @id @default(cuid())
  vendorId              String
  liveId                String
  ledgerEntryId         String
  monthKey              String
  recipientKey          String
  recipientType         String
  recipientTeamId       String?
  recipientMembershipId String?
  allocationBps         Int
  allocatedWatchSeconds Int
  policyVersion         Int
  attributionMode       String
  createdAt             DateTime @default(now())

  vendor      Vendor                 @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  live        Live                   @relation(fields: [vendorId, liveId], references: [vendorId, id], onDelete: Cascade)
  ledgerEntry StreamUsageLedgerEntry @relation(fields: [vendorId, ledgerEntryId], references: [vendorId, id], onDelete: Cascade)
  recipient   TeamMembership?        @relation(fields: [vendorId, recipientTeamId, recipientMembershipId], references: [vendorId, teamId, id], onDelete: Restrict)

  @@unique([vendorId, ledgerEntryId, recipientKey])
  @@index([vendorId, monthKey, recipientKey])
  @@index([recipientMembershipId, monthKey])
}

