model AffiliatePayout {
  id                            String    @id @default(cuid())
  vendorId                      String
  affiliateId                   String
  monthKey                      String
  commissionAmountCents         Int       @default(0)
  adjustmentAmountCents         Int       @default(0)
  finalAmountCents              Int       @default(0)
  /// Human-entered sanitized transfer/provider reference required before paid.
  outcomeReference              String?
  /// Human-entered payment note or void reason preserved on the payout read model.
  outcomeReason                 String?
  /// Optional for payout rows created before the gross/net reference contract.
  /// New rows snapshot the source transaction reference; null is shown as unknown.
  grossSalesAmountCents         Int?
  netReferenceAmountCents       Int?
  status                        String    @default("pending")
  payoutItemId                  String?
  /// The promoter explicitly requested this payable through the Affiliate Portal.
  requestedAt                   DateTime?
  /// Encrypted destination snapshot captured at request time.
  requestedBankAccountEncrypted String?
  paidAt                        DateTime?
  createdAt                     DateTime  @default(now())
  updatedAt                     DateTime  @updatedAt

  vendor    Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  affiliate Affiliate @relation(fields: [vendorId, affiliateId], references: [vendorId, id], onDelete: Restrict)

  @@unique([vendorId, affiliateId, monthKey])
  @@index([vendorId, monthKey])
  @@index([affiliateId, status])
  @@index([vendorId, affiliateId, requestedAt])
}

/// Merchant-owned course revenue-share snapshot. This is deliberately separate
/// from AffiliateCommission: course F/G recipients are team memberships, not
/// merchant affiliate identities, and must never inherit affiliate payout rules
/// by accident.
model CourseCommissionAllocation {
  id                          String   @id @default(cuid())
  vendorId                    String
  paymentTransactionId        String
  productId                   String
  teamConversionAttributionId String?
  recipientMembershipId       String
  recipientRole               String
  policyVersion               Int
  grossAmountCents            Int
  shareBps                    Int
  amountCents                 Int
  currency                    String
  deduplicationKey            String
  createdAt                   DateTime @default(now())

  vendor                    Vendor                        @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  paymentTransaction        PaymentTransaction            @relation(fields: [vendorId, paymentTransactionId], references: [vendorId, id], onDelete: Cascade)
  product                   Product                       @relation(fields: [vendorId, productId], references: [vendorId, id], onDelete: Restrict)
  recipient                 TeamMembership                @relation("CourseAllocationRecipient", fields: [vendorId, recipientMembershipId], references: [vendorId, id], onDelete: Restrict)
  teamConversionAttribution TeamConversionAttribution?    @relation(fields: [vendorId, teamConversionAttributionId], references: [vendorId, id], onDelete: Restrict)
  ledgerEntries             CourseCommissionLedgerEntry[]

  @@unique([vendorId, id])
  @@unique([vendorId, paymentTransactionId, recipientRole])
  @@unique([vendorId, deduplicationKey])
  @@index([vendorId, recipientMembershipId, createdAt])
  @@index([vendorId, paymentTransactionId])
}

/// Immutable accounting entries for course F/G allocations. Refunds and
/// disputes append negative/zero entries; the opening snapshot stays intact.
model CourseCommissionLedgerEntry {
  id                           String                          @id @default(cuid())
  vendorId                     String
  courseCommissionAllocationId String
  entryType                    CourseCommissionLedgerEntryType
  deduplicationKey             String
  providerName                 String
  eventIdentity                String
  disputeCaseId                String?
  amountCents                  Int
  occurredAt                   DateTime
  createdAt                    DateTime                        @default(now())

  vendor     Vendor                     @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  allocation CourseCommissionAllocation @relation(fields: [vendorId, courseCommissionAllocationId], references: [vendorId, id], onDelete: Restrict)

  @@unique([vendorId, deduplicationKey])
  @@index([vendorId, courseCommissionAllocationId, createdAt], map: "CourseCommissionLedger_v_c_a_created_idx")
  @@index([vendorId, courseCommissionAllocationId, disputeCaseId], map: "CourseCommissionLedger_v_c_a_case_idx")
}

enum CourseCommissionLedgerEntryType {
  opening_balance
  accrual
  refund
  reversal
  dispute_opened
  dispute_released
  dispute_lost
}

/// Merchant-owned course payable read model. It is intentionally separate
/// from AffiliatePayout and does not imply bank/KYC/tax or external payment
/// completion; paid/void outcomes require an explicit finance reference.
model CoursePayout {
  id                      String    @id @default(cuid())
  vendorId                String
  recipientMembershipId   String
  monthKey                String
  commissionAmountCents   Int       @default(0)
  adjustmentAmountCents   Int       @default(0)
  finalAmountCents        Int       @default(0)
  /// Optional for payout rows created before the gross/net reference contract.
  /// New rows snapshot the source transaction reference; null is shown as unknown.
  grossSalesAmountCents   Int?
  netReferenceAmountCents Int?
  status                  String    @default("pending")
  outcomeReference        String?
  outcomeReason           String?
  paidAt                  DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  vendor    Vendor         @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  recipient TeamMembership @relation("CoursePayoutRecipient", fields: [vendorId, recipientMembershipId], references: [vendorId, id], onDelete: Restrict)

  @@unique([vendorId, id])
  @@unique([vendorId, recipientMembershipId, monthKey])
  @@index([vendorId, monthKey, status])
  @@index([vendorId, recipientMembershipId, createdAt])
}

