{
  "name": "celebrate-deal-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 31023",
    "build": "node --import tsx scripts/preflight.ts --production && prisma generate && next build",
    "start": "next start --port 31023",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "typecheck:strict-index": "tsc --project tsconfig.strict-index.json --noEmit",
    "test": "vitest run",
    "test:contracts": "node --import tsx scripts/run-node-tap-contracts.ts",
    "test:line": "vitest run src/lib/line-client.test.ts src/lib/line-credentials.test.ts src/lib/line-login.test.ts src/lib/line-notification.test.ts src/lib/line-notification-materializer.test.ts src/lib/line-schema-contract.test.ts src/app/actions/line-actions.test.ts src/app/api/webhooks/line/[vendorId]/route.test.ts src/app/api/jobs/email-deliveries/route.test.ts",
    "test:interactions": "vitest run src/lib/interaction-event.test.ts src/lib/live-interaction.test.ts src/lib/live-interaction-schema-contract.test.ts src/lib/commerce-orders.test.ts src/components/interaction-script-form.test.tsx src/components/live-playback.test.tsx src/app/actions/interaction-actions.test.ts src/app/api/live-interactions/route.test.ts src/app/api/payments/checkout/route.test.ts \"src/app/(viewer)/live/[slug]/page.test.tsx\" \"src/app/checkout/[vendorId]/[productId]/page.test.tsx\"",
    "test:db:concurrency": "vitest run --config vitest.synthetic-db-coverage.config.ts",
    "security:bank-accounts:backfill": "tsx scripts/backfill-bank-account-encryption.ts",
    "test:coverage": "node --import tsx scripts/run-combined-coverage.mjs",
    "e2e": "playwright test",
    "e2e:smoke": "prisma generate && playwright test tests/e2e/smoke.spec.ts",
    "e2e:a11y": "prisma generate && playwright test tests/e2e/accessibility.spec.ts",
    "e2e:performance": "prisma generate && playwright test tests/e2e/performance.spec.ts",
    "secret:scan": "node --import tsx scripts/secret-scan.ts",
    "preflight": "node --import tsx scripts/preflight.ts",
    "external:smoke": "node --import tsx scripts/external-smoke.ts",
    "payuni:fixture": "node --import tsx scripts/payuni-webhook-fixtures.ts",
    "qa:payuni:sandbox": "node scripts/payuni-sandbox-external-qa.mjs",
    "secure:staging:contract": "node --import tsx --test scripts/secure-staging-runner.test.mjs scripts/secure-staging-wp4-payuni.test.mjs scripts/secure-staging-workflow-contract.test.mjs scripts/validate-secure-staging-receipt.test.mjs scripts/validate-secure-staging-wp4-receipt.test.mjs scripts/mvp-payuni-sandbox-e2e.test.mjs",
    "secure:staging:wp2": "node --import tsx scripts/secure-staging-runner.mjs wp2-readonly-restore",
    "secure:staging:wp4": "node scripts/mvp-payuni-sandbox-e2e.mjs",
    "release:verify:local": "node scripts/release-local-readiness.mjs verify",
    "test:release-readiness": "vitest run scripts/release-local-readiness.test.mjs",
    "cloudflare:fixtures": "node --import tsx scripts/cloudflare-webhook-fixtures.ts",
    "admin:bootstrap": "node --import tsx scripts/bootstrap-platform-admin.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1106.0",
    "@aws-sdk/s3-request-presigner": "^3.1106.0",
    "@prisma/client": "^6.19.3",
    "@sentry/nextjs": "^10.64.0",
    "@types/qrcode": "^1.5.6",
    "clsx": "^2.1.1",
    "hls.js": "^1.6.16",
    "lucide-react": "^1.23.0",
    "next": "16.2.11",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tus-js-client": "^4.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "deepmerge-ts": "8.0.1",
    "fast-uri": "^3.1.5",
    "js-yaml": "^4.3.1",
    "nanoid": "^3.3.17",
    "minimatch@10.2.5": {
      "brace-expansion": "^5.0.9"
    },
    "minimatch@3.1.5": {
      "brace-expansion": "^1.1.18"
    },
    "postcss": "^8.5.16",
    "sharp": "^0.35.3"
  }
}
