{
  "name": "celebrate-deal-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 31023",
    "build": "npm run preflight && prisma generate && next build",
    "start": "next start --port 31023",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "typecheck:strict-index": "tsc --project tsconfig.strict-index.json --noEmit",
    "test": "vitest run",
    "security:bank-accounts:backfill": "tsx scripts/backfill-bank-account-encryption.ts",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:smoke": "prisma generate && playwright test tests/e2e/smoke.spec.ts",
    "e2e:a11y": "prisma generate && playwright test tests/e2e/accessibility.spec.ts",
    "e2e:performance": "prisma generate && playwright test tests/e2e/performance.spec.ts",
    "secret:scan": "node --import tsx scripts/secret-scan.ts",
    "preflight": "node --import tsx scripts/preflight.ts",
    "external:smoke": "node --import tsx scripts/external-smoke.ts",
    "payuni:fixture": "node --import tsx scripts/payuni-webhook-fixtures.ts",
    "qa:payuni:sandbox": "node --env-file=.env.local scripts/payuni-sandbox-external-qa.mjs",
    "cloudflare:fixtures": "node --import tsx scripts/cloudflare-webhook-fixtures.ts",
    "admin:bootstrap": "node --import tsx scripts/bootstrap-platform-admin.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@sentry/nextjs": "^10.64.0",
    "@types/qrcode": "^1.5.6",
    "clsx": "^2.1.1",
    "hls.js": "^1.6.16",
    "lucide-react": "^1.23.0",
    "next": "16.2.11",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "fast-uri": "^3.1.4",
    "postcss": "^8.5.16",
    "sharp": "^0.35.3"
  }
}
